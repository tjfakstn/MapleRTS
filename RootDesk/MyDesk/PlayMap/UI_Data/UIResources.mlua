	@DisplayName("선택 테두리 스프라이트(흰색 타원 링, 스크립트가 색 입힘)")
	property string UnitSelectRing = "de49f4864507496ca60644db5fbffc85"

	method string GetRuid(string key)
		-- key("CmdMove", "AbTaunt" 등 위 프로퍼티 이름)에 해당하는 RUID를 돌려준다. 없는 키면 빈 문자열.
		local map = {
			CmdMove = self.CmdMove,
			CmdStop = self.CmdStop,
			CmdAttack = self.CmdAttack,
			CmdPatrol = self.CmdPatrol,
			CmdHold = self.CmdHold,
			CmdBuild = self.CmdBuild,
			CmdBuildAdvanced = self.CmdBuildAdvanced,
			CmdGather = self.CmdGather,
			CmdReturn = self.CmdReturn,
			CmdRepair = self.CmdRepair,
			CmdAbility = self.CmdAbility,
			CmdHeroSkill = self.CmdHeroSkill,
			CmdCancel = self.CmdCancel,
			CmdBack = self.CmdBack,
			HudPopulation = self.HudPopulation,
			HudLock = self.HudLock,
			AbTaunt = self.AbTaunt,
			AbDefense = self.AbDefense,
			AbBarrier = self.AbBarrier,
			AbCharge = self.AbCharge,
			AbAuraAttack = self.AbAuraAttack,
			AbAuraVision = self.AbAuraVision,
			AbThrowPoison = self.AbThrowPoison,
			AbThrowIce = self.AbThrowIce,
			AbThrowCurse = self.AbThrowCurse,
			AbThrowMixed = self.AbThrowMixed,
			AbStrikePhysical = self.AbStrikePhysical,
			AbBlastFire = self.AbBlastFire,
			AbStrikeDark = self.AbStrikeDark,
			AbStrikeLightning = self.AbStrikeLightning,
			AbMine = self.AbMine,
			AbStealth = self.AbStealth,
			AbBombard = self.AbBombard,
			AbSiege = self.AbSiege,
			AbMount = self.AbMount,
			AbHeal = self.AbHeal,
			UnitHpBar = self.UnitHpBar,
			UnitSelectRing = self.UnitSelectRing,
		}
		local v = map[key]
		if v == nil then
			return ""
		end
		return v
	end

end