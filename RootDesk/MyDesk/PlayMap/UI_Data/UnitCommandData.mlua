@Logic
script UnitCommandData extends Logic

	property table ProductionKeys = { "Z", "X", "C", "V", "B", "N", "D", "F", "G" }

	method table GetUnitData(string modelKey)
		-- modelKey("model://uuid" 또는 "uuid")에 해당하는 유닛 단축키 데이터를 돌려준다. 없으면 nil.
		if modelKey == nil or modelKey == "" then return nil end
		local key = (string.gsub(modelKey, "^model://", ""))
		if self._T.units == nil then
			self._T.units = self:BuildUnitTable()
		end
		return self._T.units[string.lower(key)]
	end

	method table BuildUnitTable()
		-- 시트에서 자동 생성한 52종 표. Abilities의 Key가 "L"(치유)인 능력만 기존 힐 기능(Heal)과 연결되고,
		-- 나머지 고유 능력은 아직 게임 로직이 없어 커맨드카드에서 잠금 표시된다(CommandCardLogic 참고).
