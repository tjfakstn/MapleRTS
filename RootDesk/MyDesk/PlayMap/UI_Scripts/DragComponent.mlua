@Component
script DragComponent extends Component

	property Vector2 StartPoint = Vector2(0,0)

	property Vector2 EndPoint = Vector2(0,0)

	property LineGUIRendererComponent Line = "423beed0-f272-481f-b22f-ae65fdb691f5"

	property table SelectedUnits = {}

	property boolean IsRightMousePressed = false

	property integer DragStartCount = 0

	property Entity target = nil

	property string PlayMapName = "map02"

	property number ClickThreshold = 8

	@DisplayName("더블클릭 인정 시간(초)")
	property number DoubleClickSeconds = 0.35

	@HideFromInspector
	property string _lastClickKey = ""

	@HideFromInspector
	property number _lastClickTime = 0

	@HideFromInspector
	property boolean _ignoreThisTouch = false

	@HideFromInspector
	property integer _activeTouchId = 0

	@HideFromInspector
	property boolean _didDrag = false

	@HideFromInspector
	property Vector2 _startWorld = Vector2(0, 0)

	method boolean IsActiveMap()
		-- 드래그 선택은 게임 맵(map02)에서만 동작해야 한다. 로비(map01)에서는 무시.
		local lp = _UserService.LocalPlayer
		if not isvalid(lp) then return false end
		local m = lp.CurrentMap
		return isvalid(m) and m.Name == _LobbyController.GameMapName
	end

	method void MakeSquare(Vector2 Point)
		--LineGUIRenderer를 이용해 Drag시 사각형을 만드는 code--
		--Point(Parameter): Event에서 받아들인 마우스 포인터의 위치를 가져옴--
		--누른 위치(시작 점) + Drag하면서 마우스 포인터의 위치를 이용해서 사각형 만들기--
		-- 시작점은 월드 좌표로 기억해 둔 값을 현재 화면 좌표로 되돌려 쓴다(드래그 중 카메라가 스크롤돼도 사각형이 시작한 땅에 붙어 있다).
		local StartPoint = _DragLogic:ScreenToUI(_UILogic:WorldToScreenPosition(self._startWorld))
		local NowPoint = _DragLogic:ScreenToUI(Point)
		
		--Line을 만들 Line UIEntity가져오기--
		local line = self.Line
		
		--기존 Point를 초기화하고 새로운 점을 추가해 사각형 제작--
		line.Points:Clear()
		line.Points:Add(LinePoint(Vector2(StartPoint.x, StartPoint.y), Color(0, 0, 1, 1), 50))
		line.Points:Add(LinePoint(Vector2(NowPoint.x, StartPoint.y), Color(0, 0, 1, 1), 50))
		line.Points:Add(LinePoint(Vector2(NowPoint.x, NowPoint.y), Color(0, 0, 1, 1), 50))
		line.Points:Add(LinePoint(Vector2(StartPoint.x, NowPoint.y), Color(0, 0, 1, 1), 50))
	end

	method void DragEnd()
		--Event로 Drag가 끝나면 실행되는 code 유닛들과 만들어진 Point들의 위치를 초기화--
		self:GetUnits()
		self:ClearPoints()
	end

	method void ClearPoints()
		--Point 초기화 Method--
		if isvalid(self.Line) then self.Line.Points:Clear() end
	end

	method void GetUnits()
		-- 드래그가 끝났을 때 호출. 시작점과 끝점이 ClickThreshold(화면 px)보다 가까우면 "좌클릭 단일 선택",
		-- 아니면 사각형 안의 내 유닛을 모두 선택한다. 선택 결과/정보 패널/커맨드카드 갱신은 SelectionLogic이 맡는다.
		local currentmap = _UserService.LocalPlayer.CurrentMap
		if not isvalid(currentmap) then
			return
		end
		
		local dx = self.EndPoint.x - self.StartPoint.x
		local dy = self.EndPoint.y - self.StartPoint.y
		if not self._didDrag and (dx * dx + dy * dy) <= (self.ClickThreshold * self.ClickThreshold) then
			self:SelectAtPoint(currentmap, self.EndPoint)
			return
		end
		
		--유닛을 한 EmptyEntity에 넣어서 그 안에 Unit이 존재--
		local UnitGroup = currentmap:GetChildByName("MyUnits")
		if not isvalid(UnitGroup) then
			_SelectionLogic:SelectUnits({})
			return
		end
		
		--처음 위치와 마지막 위치의 좌표를 가지고 그 안에 있는 유닛들을 Table에 담음--
		-- 시작점은 누른 순간의 월드 좌표를 쓴다(그 사이 카메라가 스크롤돼도 선택 범위가 어긋나지 않게).
		local StartPoint = self._startWorld
		local EndPoint = _DragLogic:ScreenToWorld(self.EndPoint)
		
		local localUserID = _UserService.LocalPlayer.PlayerComponent.UserId
		local picked = {}
		
		--Unit이 있는 Group을 이용--
		--1. Unit이 움직일 수 있는가?--
		--2. Drag 안으로 들어오는가?--
		for k, v in pairs(UnitGroup.Children) do
			if not v.UnitMoveComponent then
				continue
			end
		
			--MyUnits 자식이라는 이유만으로 포함하지 않고, 소유자(PlayerID)가 나와 일치하고 살아 있을 때만 선택--
			local vinfo = v.Unit_Info
			-- 부활 대기 중인 영웅(HeroUnit.ReviveAt > 0)은 사망 상태여도 선택에 남겨 카운트다운을 볼 수 있게 한다(SelectionLogic.IsMyAliveUnit과 동일 규칙).
			local heroComp = vinfo ~= nil and v:GetComponent("script.HeroUnit") or nil
			local reviving = heroComp ~= nil and (heroComp.ReviveAt or 0) > 0
			if vinfo == nil or vinfo.PlayerID ~= localUserID or (vinfo.IsDead and not reviving) then
				continue
			end
		
			local trasform = v.TransformComponent
			local Position = trasform.WorldPosition
			if(_DragLogic:IsInside(Position.x, StartPoint.x, EndPoint.x)) and
			(_DragLogic:IsInside(Position.y, StartPoint.y, EndPoint.y)) then
				table.insert(picked, v.UnitMoveComponent)
			end
		end
		_SelectionLogic:SelectUnits(picked)
	end

	method void SelectAtPoint(Entity currentmap, Vector2 screenPoint)
		-- 좌클릭 단일 선택: 클릭 지점의 유닛/건물/몬스터를 Mouse_Command와 같은 판정(PickEntityAt)으로 찾는다.
		-- 아무것도 없으면 선택 해제(빈 땅 좌클릭).
		---@type Mouse_Command
		local mouse = currentmap:GetComponent("script.Mouse_Command")
		local target = nil
		if mouse ~= nil then
			target = mouse:PickEntityAt(_DragLogic:ScreenToWorld(screenPoint))
		else
		end
		-- 내 유닛을 짧은 시간 안에 같은 종류로 두 번 누르면 화면 안의 같은 종류 내 유닛을 전부 그룹으로 선택한다.
		local now = _UtilLogic.ElapsedSeconds
		if isvalid(target) and _SelectionLogic:IsMyAliveUnit(target) then
			local key = _SelectionLogic:UnitTypeKey(target)
			if key ~= "" and key == self._lastClickKey and now - self._lastClickTime <= self.DoubleClickSeconds then
				self._lastClickKey = ""
				self._lastClickTime = 0
				self:SelectSameType(currentmap, target)
				return
			end
			self._lastClickKey = key
			self._lastClickTime = now
		else
			self._lastClickKey = ""
		end
		_SelectionLogic:SelectSingle(target)
	end

	method void SelectSameType(Entity currentmap, Entity clicked)
		-- 더블클릭: 현재 화면(카메라 앵커 ± RTSCameraLogic.GetViewExtents) 안에 있는 내 살아있는 유닛 중 clicked와 같은 모델을 전부 선택한다.
		local group = currentmap:GetChildByName("MyUnits")
		local lp = _UserService.LocalPlayer
		if not isvalid(group) or not isvalid(lp) then
			_SelectionLogic:SelectSingle(clicked)
			return
		end
		local key = _SelectionLogic:UnitTypeKey(clicked)
		-- 화면 네 모서리의 월드 좌표로 "보이는 범위"를 직접 구한다(현재 선택 여부와 무관하게 화면 안의 같은 종류 전부).
		local bl = _UILogic:ScreenToWorldPosition(Vector2(0, 0))
		local tr = _UILogic:ScreenToWorldPosition(Vector2(_UILogic.ScreenWidth, _UILogic.ScreenHeight))
		local minX, maxX = math.min(bl.x, tr.x), math.max(bl.x, tr.x)
		local minY, maxY = math.min(bl.y, tr.y), math.max(bl.y, tr.y)
		local picked = {}
		for _, v in pairs(group.Children) do
			if v.UnitMoveComponent ~= nil and v.Unit_Info ~= nil and _SelectionLogic:IsMyAliveUnit(v) and _SelectionLogic:UnitTypeKey(v) == key then
				local p = v.TransformComponent.WorldPosition
				if p.x >= minX and p.x <= maxX and p.y >= minY and p.y <= maxY then
					table.insert(picked, v.UnitMoveComponent)
				end
			end
		end
		_SelectionLogic:SelectUnits(picked)
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleScreenTouchEvent(ScreenTouchEvent event)
		--Event를 이용해서 좌클릭시(새로 드래그) 기존 선택된 Unit들의 선택여부 falss--
		--Unit Table 초기화--
		--Drag 시작점 가져오기--
		if event.TouchId ~= 1 then return end
		self._activeTouchId = 0
		self._didDrag = false
		self:ClearPoints()
		if not self:IsActiveMap() then
			return
		end
		-- 건물 배치(고스트 프리뷰) 중인 좌클릭은 배치 확정용이다 — 드래그/선택 해제로 취급하지 않는다.
		if _BuildModeLogic.IsPlacing then
			self._ignoreThisTouch = true
			return
		end
		-- 힐 대상 지정 대기 중(힐 버튼을 누른 직후, 다음 우클릭을 기다리는 중) 좌클릭이 들어오면
		-- 평소처럼 선택 해제 + UI Clear를 해버려 방금 연 힐 버튼 패널이 사라지는 문제가 있었다.
		-- 대기 중에는 좌클릭을 무시해 패널이 유지되게 한다.
		if _HealTargetLogic.IsTargeting then
			self._ignoreThisTouch = true
			-- 2026-10-07: 좌클릭으로도 치유 대상을 지정한다(스타처럼 L → 좌클릭). 예전엔 좌클릭을 무시해 지정 모드가 남았고,
			-- 그다음 우클릭 이동 명령이 치유 대상 지정으로 먹혀 "명령을 안 듣는" 것처럼 보였다. UI 위 클릭은 대기 유지.
			if not _InputService:IsPointerOverUI() then
				local map = _UserService.LocalPlayer.CurrentMap
				---@type Mouse_Command
				local mouse = isvalid(map) and map:GetComponent("script.Mouse_Command") or nil
				if mouse ~= nil then
					mouse:ResolveHealTarget(mouse:PickEntityAt(_DragLogic:ScreenToWorld(event.TouchPoint)))
				end
			end
			return
		end
		-- 메소 채집 대상 지정 대기 중(채집 버튼을 누른 직후)도 마찬가지로 좌클릭을 무시해 액션 패널이 유지되게 한다.
		if _GatherTargetLogic.IsTargeting then
			self._ignoreThisTouch = true
			return
		end
		-- 커맨드카드 위치 지정 대기 중(M 이동 / A 공격 / 영웅 스킬): 스타처럼 좌클릭 위치로 바로 실행한다
		-- (선택은 바꾸지 않음). UI(커맨드카드 버튼 등) 위 좌클릭이면 대기를 유지한다.
		if _CommandCardLogic.PendingCommand ~= "" then
			self._ignoreThisTouch = true
			if not _InputService:IsPointerOverUI() then
				local map = _UserService.LocalPlayer.CurrentMap
				---@type Mouse_Command
				local mouse = isvalid(map) and map:GetComponent("script.Mouse_Command") or nil
				if mouse ~= nil then
					mouse:ExecutePendingAt(_DragLogic:ScreenToWorld(event.TouchPoint))
				end
			end
			return
		end
		-- UI(생산 버튼 등) 위에서 시작된 클릭은 월드 드래그/선택 해제로 취급하지 않는다.
		-- 이 체크가 없으면 건물을 선택한 뒤 생산 버튼을 눌러도 이 핸들러가 함께 실행되어
		-- ClearUI()가 호출되면서 방금 선택한 건물의 정보 UI가 곧바로 사라져버린다.
		-- 이 터치가 UI 위에서 시작됐는지를 down 시점에 한 번만 판정해 기억해두고,
		-- 같은 터치 시퀀스의 hold/release에서도 동일하게 무시한다(아래 두 핸들러 참고).
		if _InputService:IsPointerOverUI() then
			self._ignoreThisTouch = true
			return
		end
		self._ignoreThisTouch = false
		self._activeTouchId = event.TouchId
		self.StartPoint = event.TouchPoint
		self._startWorld = _DragLogic:ScreenToWorld(event.TouchPoint)
		-- 끝점도 시작점으로 초기화해 둔다(릴리즈 전에 끝점이 갱신되지 않아도 이전 드래그 값이 섞이지 않게).
		self.EndPoint = event.TouchPoint
		-- 새 드래그가 시작됐음을 알린다(카메라 유닛 고정 해제용).
		self.DragStartCount += 1
		-- 기존 선택 해제는 릴리즈 시점에 SelectionLogic이 한다(짧은 클릭이면 단일 선택, 드래그면 범위 선택).
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleScreenTouchHoldEvent(ScreenTouchHoldEvent event)
		--계속 좌클릭 유지시 그 위치를 계속 MakeSquare함수에 전달--
		if not self:IsActiveMap() then
			return
		end
		if self._ignoreThisTouch or self._activeTouchId ~= event.TouchId then
			return
		end
		local NowPoint = event.TouchPoint
		local dx = NowPoint.x - self.StartPoint.x
		local dy = NowPoint.y - self.StartPoint.y
		if dx * dx + dy * dy > self.ClickThreshold * self.ClickThreshold then self._didDrag = true end
		if self._didDrag then self:MakeSquare(NowPoint) end
	end

	@ExecSpace("ClientOnly")
	@EventSender("Service", "InputService")
	handler HandleScreenTouchReleaseEvent(ScreenTouchReleaseEvent event)
		--Drag가 끝나면 그 위치를 전달하고 DragEnd()함수 실행--
		if self._activeTouchId ~= event.TouchId then return end
		self._activeTouchId = 0
		self:ClearPoints()
		-- 놓는 위치가 하단 정보/커맨드 패널 위여도 선택은 확정한다(UI 위 판정은 누르는 시점에만 한다).
		if not self:IsActiveMap() or self._ignoreThisTouch then return end
		self.EndPoint = event.TouchPoint
		self:DragEnd()
	end

end