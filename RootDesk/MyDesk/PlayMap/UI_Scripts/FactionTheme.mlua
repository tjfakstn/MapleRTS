@Component
script FactionTheme extends Component

	@HideFromInspector
	property boolean _applied = false

	@HideFromInspector
	property number _elapsed = 0

	property number WaitSeconds = 10

	@HideFromInspector
	property string _appliedCamp = ""

	@HideFromInspector
	property integer _sceneVersion = -1

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self._applied = false
		self._elapsed = 0
		self._appliedCamp = ""
		self._sceneVersion = -1
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- 재경기 대응: 맵 전환(SceneController.SceneVersion 변화) 또는 로컬 진영 변경 시 테마를 다시 적용한다.
		if _SceneController.SceneVersion ~= self._sceneVersion then
			self._sceneVersion = _SceneController.SceneVersion
			self._applied = false
			self._elapsed = 0
		end
		local camp = self:LocalCamp()
		if self._applied then
			-- 진영이 바뀌었으면(다음 경기에서 다른 진영 선택) 즉시 다시 칠한다. 빈 값(초기화 직후)은 무시.
			if camp ~= "" and camp ~= self._appliedCamp then
				self:Apply(camp)
				self._appliedCamp = camp
			end
			return
		end
		self._elapsed = self._elapsed + delta
		if camp == "" then
			if self._elapsed < self.WaitSeconds then return end
			camp = "Adv"
		end
		self:Apply(camp)
		self._appliedCamp = camp
		self._applied = true
	end

	@ExecSpace("ClientOnly")
	method string LocalCamp()
		-- 로컬 플레이어가 대기실에서 고른 진영("Adv" / "Cyg" / "Ede"). 아직 동기화 전이면 빈 문자열.
		local lp = _UserService.LocalPlayer
		if not isvalid(lp) then return "" end
		---@type PlayerInfo
		local info = lp:GetComponent("script.PlayerInfo")
		if info == nil then return "" end
		return info.SelectedCamp or ""
	end

	@ExecSpace("ClientOnly")
	method table Palette(string camp)
		-- frame: 패널 프레임 / inner: 속판 / ink: 제목 글자 / sub: 보조 글자 / slot: 칸 배경 / hk: 단축키 글자 / chip: 스탯 칩 배경
		-- edge: 미니맵 테두리 안쪽 선(초안의 진영 강조선 — 모험가 남색 외곽선 / 시그너스 금선 / 레지스탕스 주황)
		if camp == "Cyg" then
			-- 에레브: 상아빛 프레임 + 흰 속판 + 진청 글자, 칸은 진청, 단축키는 연한 금색
			return {
				frame = Color(0.957, 0.945, 0.894, 1.0),
				inner = Color(1.0, 1.0, 1.0, 1.0),
				ink = Color(0.118, 0.235, 0.392, 1.0),
				sub = Color(0.357, 0.478, 0.612, 1.0),
				slot = Color(0.118, 0.235, 0.392, 0.95),
				hk = Color(1.0, 0.878, 0.541, 1.0),
				chip = Color(0.431, 0.776, 0.910, 0.18),
				edge = Color(0.851, 0.714, 0.353, 1.0),
			}
		elseif camp == "Ede" then
			-- 에델슈타인: 어두운 철판 + 더 어두운 속판 + 밝은 글자, 칸은 회색 철판, 단축키는 메이플 노랑
			return {
				frame = Color(0.180, 0.184, 0.200, 1.0),
				inner = Color(0.106, 0.110, 0.125, 1.0),
				ink = Color(0.910, 0.922, 0.937, 1.0),
				sub = Color(0.604, 0.639, 0.678, 1.0),
				slot = Color(0.227, 0.235, 0.259, 0.95),
				hk = Color(1.0, 0.824, 0.247, 1.0),
				chip = Color(1.0, 1.0, 1.0, 0.08),
				edge = Color(0.910, 0.333, 0.173, 1.0),
			}
		end
		-- 모험가(기본): 클래식 메이플 창
		return {
			frame = Color(0.749, 0.878, 0.965, 1.0),
			inner = Color(0.965, 0.984, 1.0, 1.0),
			ink = Color(0.122, 0.227, 0.392, 1.0),
			sub = Color(0.353, 0.451, 0.584, 1.0),
			slot = Color(0.169, 0.184, 0.235, 0.95),
			hk = Color(1.0, 0.824, 0.247, 1.0),
			chip = Color(0.122, 0.227, 0.392, 0.10),
			edge = Color(0.122, 0.227, 0.392, 1.0),
		}
	end

	@ExecSpace("ClientOnly")
	method void Tint(string path, Color color)
		-- 경로의 엔티티 SpriteGUIRenderer 색을 바꾼다. 없으면 조용히 넘어간다(UI 구조가 바뀌어도 터지지 않게).
		local e = _EntityService:GetEntityByPath(path)
		if not isvalid(e) or e.SpriteGUIRendererComponent == nil then return end
		e.SpriteGUIRendererComponent.Color = color
	end

	@ExecSpace("ClientOnly")
	method void Ink(string path, Color color)
		-- 경로의 엔티티 TextGUIRenderer 글자색을 바꾼다.
		local e = _EntityService:GetEntityByPath(path)
		if not isvalid(e) or e.TextGUIRendererComponent == nil then return end
		e.TextGUIRendererComponent.FontColor = color
	end

	@ExecSpace("ClientOnly")
	method void Apply(string camp)
		local p = self:Palette(camp)
		local B = "/ui/UIGroup/BasicUI/"
		
		-- 프레임 2개(정보 패널, 커맨드카드). 초상화(UnitSpriteUI)는 유닛 스프라이트 자체라 건드리지 않는다.
		self:Tint(B .. "UnitInfoUI", p.frame)
		self:Tint(B .. "UnitActionUI", p.frame)
		
		-- 미니맵 테두리(PlayMapUI 가장자리 안쪽 띠 4개 + 안쪽 선 4개)
		for _, side in ipairs({ "Top", "Bottom", "Left", "Right" }) do
			self:Tint(B .. "PlayMapUI/Frame_" .. side, p.frame)
			self:Tint(B .. "PlayMapUI/Line_" .. side, p.edge)
		end
		
		-- 단일 선택 정보 패널
		local SI = B .. "UnitInfoUI/SelectedUnit_Info/"
		self:Tint(SI .. "Inner", p.inner)
		self:Ink(SI .. "NameText", p.ink)
		self:Ink(SI .. "RoleText", p.sub)
		self:Ink(SI .. "StatusText", p.sub)
		for _, n in ipairs({ "StatAtk", "StatDef", "StatRng" }) do
			self:Tint(SI .. n, p.chip)
			self:Ink(SI .. n, p.ink)
		end
		
		-- 다중 선택 패널
		local SU = B .. "UnitInfoUI/SelectedUnits/"
		self:Tint(SU .. "Inner", p.inner)
		self:Ink(SU .. "CountText", p.ink)
		self:Ink(SU .. "HintText", p.sub)
		for i = 1, 12 do
			self:Tint(SU .. "Slot" .. tostring(i), p.slot)
		end
		
		-- 생산 큐 칸
		for _, n in ipairs({ "ProductionPreview", "ProductionPreview_1", "ProductionPreview_2", "ProductionPreview_3", "ProductionPreview_4" }) do
			self:Tint(B .. "UnitInfoUI/" .. n, p.slot)
		end
		
		-- 커맨드카드 칸 10개
		for i = 1, 10 do
			local s = B .. "UnitActionUI/Slot" .. tostring(i)
			self:Tint(s, p.slot)
			self:Ink(s .. "/Hotkey", p.hk)
			self:Ink(s .. "/Lock/Reason", p.hk)
		end
		
	end

end