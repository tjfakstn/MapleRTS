@Logic
script StructureSizeLogic extends Logic

	@DisplayName("최대 변 길이 배율(TargetSize 대비)")
	property number MaxSideRatio = 1.35

	@DisplayName("자동 충돌 박스 가로 비율")
	property number FitBoxWidth = 0.8

	@DisplayName("자동 충돌 박스 세로 비율")
	property number FitBoxHeight = 0.7

	@DisplayName("체력바 배경 두께(월드)")
	property number BarBgThickness = 0.33

	@DisplayName("체력바 채움 두께(월드)")
	property number BarFillThickness = 0.24

	@DisplayName("체력바 높이 여백(박스 위, 월드)")
	property number BarGap = 0.4

	@DisplayName("선택 테두리 가로 배율(박스 대비)")
	property number RingWidthRatio = 1.28

	method table MeasureSprite(string ruid)
		-- 스프라이트(또는 애니메이션 클립 전체 프레임)의 피벗 기준 사각형을 Scale 1 월드 유닛으로 돌려준다.
		-- { w, h, cx, cy } — cx/cy는 피벗에서 사각형 중심까지의 거리. 읽지 못하면 nil. RUID별로 캐시한다.
		if ruid == nil or ruid == "" then return nil end
		if self._T.cache == nil then self._T.cache = {} end
		local cached = self._T.cache[ruid]
		if cached ~= nil then return cached end
		
		local ok, result = pcall(function()
			local bounds = nil
			local kind = _ResourceService:GetTypeAndWait(ruid)
			if kind == ResourceType.Sprite then
				local sprite = _ResourceService:LoadSpriteAndWait(ruid)
				if sprite == nil or sprite.Width <= 1 or sprite.Height <= 1 then return nil end
				local ppu = math.max(1, sprite.PixelPerUnit)
				bounds = { -sprite.PivotPixel.x / ppu, -sprite.PivotPixel.y / ppu,
					(sprite.Width - sprite.PivotPixel.x) / ppu, (sprite.Height - sprite.PivotPixel.y) / ppu }
			elseif kind == ResourceType.AnimationClip then
				local clip = _ResourceService:LoadAnimationClipAndWait(ruid)
				if clip == nil then return nil end
				local b = { math.huge, math.huge, -math.huge, -math.huge }
				for _, frame in ipairs(clip.Frames:ToTable()) do
					local sprite = frame.FrameSprite
					if sprite ~= nil and sprite.Width > 1 and sprite.Height > 1 then
						local ppu = math.max(1, sprite.PixelPerUnit)
						b[1] = math.min(b[1], -sprite.PivotPixel.x / ppu + frame.Offset.x)
						b[2] = math.min(b[2], -sprite.PivotPixel.y / ppu + frame.Offset.y)
						b[3] = math.max(b[3], (sprite.Width - sprite.PivotPixel.x) / ppu + frame.Offset.x)
						b[4] = math.max(b[4], (sprite.Height - sprite.PivotPixel.y) / ppu + frame.Offset.y)
					end
				end
				if b[1] == math.huge then return nil end
				bounds = b
			else
				return nil
			end
			return {
				w = bounds[3] - bounds[1], h = bounds[4] - bounds[2],
				cx = (bounds[1] + bounds[3]) / 2, cy = (bounds[2] + bounds[4]) / 2,
			}
		end)
		if not ok or result == nil then
			return nil
		end
		self._T.cache[ruid] = result
		return result
	end

	method number ComputeScale(table m, number target)
		-- 보이는 크기(가로·세로 기하평균)가 target이 되는 배율. 아주 길쭉한 스프라이트는 긴 변이
		-- target × MaxSideRatio를 넘지 않게 줄인다. 계산할 수 없으면 0.
		if m == nil or target <= 0 or m.w <= 0 or m.h <= 0 then return 0 end
		local s = target / math.sqrt(m.w * m.h)
		local longSide = math.max(m.w, m.h) * s
		local limit = target * self.MaxSideRatio
		if longSide > limit then
			s = s * limit / longSide
		end
		return s
	end

	method string IdleSpriteRuid(Entity e)
		-- 건물 본래 스프라이트 RUID. 클라이언트에선 건설 애니메이션이 이미 덮어썼을 수 있어 효과 컴포넌트에 보관된 값을 먼저 본다.
		---@type StructureEffectComponent
		local fx = e:GetComponent("script.StructureEffectComponent")
		if fx ~= nil and fx._idleSpriteRUID ~= nil and fx._idleSpriteRUID ~= "" then
			return fx._idleSpriteRUID
		end
		if isvalid(e.SpriteRendererComponent) then
			return e.SpriteRendererComponent.SpriteRUID
		end
		return ""
	end

	method table ResolveForEntity(Entity e)
		-- 건물 엔티티(또는 클라 로컬 프로브)의 자동 크기 결과를 계산만 한다(월드 유닛).
		-- { scale, boxW, boxH, boxX, boxY(피벗 기준 박스 중심), ruid(측정한 스프라이트) }
		-- TargetSize가 0이거나 스프라이트를 못 읽으면 nil — 호출부는 모델 값을 그대로 쓴다.
		if not isvalid(e) then return nil end
		---@type Structure_Info
		local info = e:GetComponent("script.Structure_Info")
		if info == nil or info.TargetSize <= 0 then return nil end
		local ruid = self:IdleSpriteRuid(e)
		local m = self:MeasureSprite(ruid)
		local s = self:ComputeScale(m, info.TargetSize)
		if s <= 0 then return nil end
		local box = self:LocalBox(e, info, m)
		return { scale = s, boxW = box.w * s, boxH = box.h * s, boxX = box.ox * s, boxY = box.oy * s, ruid = ruid }
	end

	method table LocalBox(Entity e, Structure_Info info, table m)
		-- 적용 후 쓰일 충돌 박스(로컬 단위). 자동 맞춤이면 스프라이트 아래쪽 FitBoxHeight 비율, 아니면 모델 값.
		local trig = e.TriggerComponent
		if info.AutoFitCollider and m ~= nil and (trig == nil or trig.ColliderType == ColliderType.Box) then
			local h = m.h * self.FitBoxHeight
			return { w = m.w * self.FitBoxWidth, h = h, ox = m.cx, oy = (m.cy - m.h / 2) + m.h * 0.05 + h / 2 }
		end
		if trig ~= nil then
			if trig.ColliderType == ColliderType.Circle then
				local r = trig.CircleRadius
				return { w = r * 2, h = r * 2, ox = trig.ColliderOffset.x, oy = trig.ColliderOffset.y }
			end
			return { w = trig.BoxSize.x, h = trig.BoxSize.y, ox = trig.ColliderOffset.x, oy = trig.ColliderOffset.y }
		end
		return { w = 1, h = 1, ox = 0, oy = 0 }
	end

	@ExecSpace("ServerOnly")
	method boolean ApplyServer(Entity e, table measured)
		-- 서버: 배율·충돌 박스·오버레이 자식(체력바/선택 테두리) 배치를 확정한다. Transform/Trigger는 클라로 동기화된다.
		-- measured가 nil이면 서버에서 직접 스프라이트를 읽는다(클라가 대신 측정해 보낸 경우 그 값을 쓴다).
		if not isvalid(e) then return false end
		---@type Structure_Info
		local info = e:GetComponent("script.Structure_Info")
		if info == nil or info.TargetSize <= 0 or info.AutoSized then return false end
		local m = measured
		if m == nil then
			m = self:MeasureSprite(self:IdleSpriteRuid(e))
		end
		local s = self:ComputeScale(m, info.TargetSize)
		if s <= 0 then return false end
		
		local tf = e.TransformComponent
		local old = tf.Scale
		local sx = (old.x < 0) and -s or s
		tf.Scale = Vector3(sx, s, old.z)
		
		local box = self:LocalBox(e, info, m)
		local trig = e.TriggerComponent
		if info.AutoFitCollider and trig ~= nil and trig.ColliderType == ColliderType.Box then
			trig.BoxSize = Vector2(box.w, box.h)
			trig.ColliderOffset = Vector2(box.ox, box.oy)
		end
		self:LayoutOverlay(e, box, s)
		info.AutoSized = true
		return true
	end

	@ExecSpace("ServerOnly")
	method void LayoutOverlay(Entity e, table box, number s)
		-- 체력바/선택 테두리 자식을 새 박스에 맞춰 다시 놓는다. 자식은 부모 Scale을 그대로 물려받으므로
		-- 두께·여백은 월드 값 ÷ s로 넣어 건물 크기와 무관하게 화면에서 같은 굵기로 보이게 한다.
		local ring = e:GetChildByName("SelectRing")
		if isvalid(ring) then
			local rt = ring.TransformComponent
			local ratio = 1
			if rt.Scale.x ~= 0 then ratio = rt.Scale.y / rt.Scale.x end
			local rw = box.w * self.RingWidthRatio
			rt.Scale = Vector3(rw, rw * ratio, rt.Scale.z)
			rt.Position = Vector3(box.ox, box.oy - box.h / 2, rt.Position.z)
		end
		local barY = box.oy + box.h / 2 + self.BarGap / s
		local fillW = box.w
		local bg = e:GetChildByName("HpBarBg")
		if isvalid(bg) then
			local bt = bg.TransformComponent
			bt.Scale = Vector3(fillW + 0.075 / s, self.BarBgThickness / s, bt.Scale.z)
			bt.Position = Vector3(box.ox, barY, bt.Position.z)
		end
		local fill = e:GetChildByName("HpBarFill")
		if isvalid(fill) then
			local ft = fill.TransformComponent
			ft.Scale = Vector3(fillW, self.BarFillThickness / s, ft.Scale.z)
			ft.Position = Vector3(box.ox, barY, ft.Position.z)
		end
	end

end