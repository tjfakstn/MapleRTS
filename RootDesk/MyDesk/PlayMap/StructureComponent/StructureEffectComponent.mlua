@Component
script StructureEffectComponent extends Component

	@DisplayName("건설 애니메이션 RUID")
	property string ConstructAnimationRUID = ""

	@DisplayName("건설 애니메이션 재생 시간(초)")
	property number ConstructAnimationDuration = 1.0

	@DisplayName("유닛 생산 이펙트 RUID")
	property string SpawnUnitEffectRUID = ""

	@DisplayName("파괴 애니메이션 RUID")
	property string DestroyAnimationRUID = ""

	@DisplayName("파괴 애니메이션 재생 시간(초)")
	property number DestroyAnimationDuration = 1.0

	@HideFromInspector
	property string _idleSpriteRUID = ""

	@HideFromInspector
	property boolean _destroyPlayed = false

	@HideFromInspector
	property any _warned = nil

	@HideFromInspector
	property any _revertTimerId = nil

	@ExecSpace("ClientOnly")
	method void OnBeginPlay()
		self._warned = {}
		
		local renderer = self.Entity.SpriteRendererComponent
		if isvalid(renderer) then
			self._idleSpriteRUID = renderer.SpriteRUID
		end
		
		-- 기본값으로 1회 재생한다. 동적으로 지어지는 건물(SpawnUnit.BuildStructureNow)은 스폰 직후
		-- 실제 건설 시간(Structure_Info.BuildTime)으로 다시 호출해 이 기본 재생을 덮어쓴다 —
		-- "건설 이펙트는 건물이 보이는 동안 그 자리에서 진행되는 이펙트"라는 요구에 맞춰, 건물은
		-- 지어지기 시작하는 즉시(도착 직후) 나타나고 건설 이펙트가 실제 건설 시간만큼 유지된다.
		self:PlayConstructAnimation(self.ConstructAnimationDuration)
	end

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Structure_Info.OnDestroyed()의 명시적 호출과 병행되는 폴백: IsDestroyed 값을 직접 폴링한다.
		if self._destroyPlayed then return end
		
		---@type Structure_Info
		local info = self.Entity:GetComponent("script.Structure_Info")
		if info ~= nil and info.IsDestroyed then
			self:PlayDestroyAnimation()
		end
	end

	@ExecSpace("ClientOnly")
	method void PlayConstructAnimation(number duration)
		-- duration: 이 건설 이펙트를 유지할 시간(초). 동적 건설(BuildStructureNow)은 실제 건설
		-- 시간(BuildTime)을 넘겨 호출해, "건물이 보이는 동안 그 자리에서" 이펙트가 유지되게 한다.
		if self.ConstructAnimationRUID == "" then
			self:WarnOnce("Construct")
			return
		end
		if duration == nil or duration <= 0 then
			duration = self.ConstructAnimationDuration
		end
		
		local renderer = self.Entity.SpriteRendererComponent
		if not isvalid(renderer) then return end
		
		-- OnBeginPlay의 기본 재생 뒤 곧바로 실제 건설 시간으로 재호출되는 경우, 먼저 걸린(기본
		-- 시간) 되돌리기 타이머가 실제 시간보다 먼저 발동해 이펙트를 일찍 꺼버리지 않도록 취소한다.
		if self._revertTimerId ~= nil then
			_TimerService:ClearTimer(self._revertTimerId)
			self._revertTimerId = nil
		end
		
		renderer.SpriteRUID = self.ConstructAnimationRUID
		
		self._revertTimerId = _TimerService:SetTimerOnce(function()
			self._revertTimerId = nil
			self:RevertWhenBuilt(renderer)
		end, duration)
	end

	@ExecSpace("ClientOnly")
	method void RevertWhenBuilt(any renderer)
		-- 건설 그림을 원래 그림으로 되돌린다. 테란식 건설(일꾼이 떠나면 멈춤)은 예정 시간보다 늦게 끝날 수 있어,
		-- 아직 짓는 중이면 0.5초 뒤 다시 확인한다(2026-10-07).
		if not isvalid(renderer) then return end
		---@type Structure_Info
		local info = self.Entity:GetComponent("script.Structure_Info")
		if info ~= nil and info.IsUnderConstruction and not info.IsDestroyed then
			self._revertTimerId = _TimerService:SetTimerOnce(function()
				self._revertTimerId = nil
				self:RevertWhenBuilt(renderer)
			end, 0.5)
			return
		end
		if info ~= nil and info.IsDestroyed then return end
		renderer.SpriteRUID = self._idleSpriteRUID
	end

	@ExecSpace("ClientOnly")
	method void PlayDestroyAnimation()
		-- 파괴 연출 진입점. Structure_Info.OnDestroyed()의 명시적 호출과 OnUpdate 폴백
		-- 양쪽에서 호출될 수 있으므로 1회만 실행되도록 잠근다.
		if self._destroyPlayed then return end
		self._destroyPlayed = true
		
		if self.DestroyAnimationRUID == "" then
			self:WarnOnce("Destroy")
			return
		end
		
		local renderer = self.Entity.SpriteRendererComponent
		if isvalid(renderer) then
			renderer.SpriteRUID = self.DestroyAnimationRUID
		end
	end

	@ExecSpace("Multicast")
	method void StartConstruction(number duration)
		-- 서버(SpawnUnit.BuildStructureNow)가 스폰 직후 호출한다. OnBeginPlay는 클라이언트별로
		-- 각자 돌아 기본 재생 시간(ConstructAnimationDuration)만 알 수 있으므로, 서버가 알고 있는
		-- 실제 건설 시간(BuildTime)으로 모든 클라이언트에서 다시 맞춰 재생하기 위한 진입점이다.
		self:PlayConstructAnimation(duration)
	end

	@ExecSpace("Multicast")
	method void PlaySpawnUnitEffect(Vector3 pos, string unitRuid, number unitScaleY)
		-- 이 건물에서 유닛이 생산될 때마다 서버(SpawnUnit)가 호출한다. 모든 클라이언트에서 재생된다.
		-- pos: 새로 생산된 유닛의 월드 위치(피벗 기준). unitRuid/unitScaleY: 그 유닛의 스프라이트와 세로 배율.
		-- 이펙트의 "아랫단"이 유닛 스프라이트의 "아랫단"에 오도록 위치를 보정한다:
		--   이펙트 y = 유닛 y - (유닛 피벗~아랫단 거리) + (이펙트 피벗~아랫단 거리)
		if self.SpawnUnitEffectRUID == "" then
			self:WarnOnce("SpawnUnit")
			return
		end
		local unitBottom = self:GetPivotToBottom(unitRuid) * (unitScaleY or 1)
		local effectBottom = self:GetPivotToBottom(self.SpawnUnitEffectRUID)
		local effectPos = Vector3(pos.x, pos.y - unitBottom + effectBottom, pos.z)
		_FogOfWarLogic:PlayEffectSeen(self.SpawnUnitEffectRUID, self.Entity, effectPos, 0, Vector3(1, 1, 1), false, nil)
	end

	method number GetPivotToBottom(string ruid)
		-- 스프라이트(또는 애니메이션 클립 첫 프레임)의 피벗에서 아랫단까지의 거리(world unit, 피벗 픽셀 y ÷ PPU).
		-- 리소스를 읽지 못하면 0(피벗이 곧 아랫단이라고 본다).
		if ruid == nil or ruid == "" then return 0 end
		local ok, value = pcall(function()
			-- 리소스 종류를 먼저 확인한다. 낱장 스프라이트를 애니메이션 클립으로 읽으면
			-- ResourceService가 해석 오류([LEA-3015] CannotLoad)를 내므로 종류에 맞는 로더만 쓴다.
			local kind = _ResourceService:GetTypeAndWait(ruid)
			local sprite = nil
			if kind == ResourceType.Sprite then
				sprite = _ResourceService:LoadSpriteAndWait(ruid)
			elseif kind == ResourceType.AnimationClip then
				local clip = _ResourceService:LoadAnimationClipAndWait(ruid)
				sprite = clip.Frames:ToTable()[1].FrameSprite
			end
			if sprite == nil or sprite.PixelPerUnit == 0 then return 0 end
			return sprite.PivotPixel.y / sprite.PixelPerUnit
		end)
		if ok and type(value) == "number" then
			return value
		end
		return 0
	end

	method void WarnOnce(string kind)
		-- 비어 있는 RUID 경고를 종류별 1회만 출력(로그 스팸 방지). UnitStateComponent.WarnOnce와 동일한 패턴.
		if self._warned == nil then self._warned = {} end
		if self._warned[kind] then return end
		self._warned[kind] = true
	end

end