@Logic
script CommandCardLogic extends Logic

	property integer SlotCount = 10

	property table Actions = {}

	property string Mode = "base"

	property Entity SubSource = nil

	@HideFromInspector
	property string SubKind = "basic"

	@HideFromInspector
	property table _structNames = {}

	@HideFromInspector
	property string _structNamesCamp = ""

	property string PendingCommand = ""

	property string PendingArg = ""

	@ExecSpace("ClientOnly")
	method string LocalUserId()
		-- 로컬 플레이어 UserId(없으면 빈 문자열).
		local lp = _UserService.LocalPlayer
		if not isvalid(lp) or not isvalid(lp.PlayerComponent) then return "" end
		return lp.PlayerComponent.UserId
	end

	@ExecSpace("ClientOnly")
	method table MakeAction(string actionId, string hotkey, string label, string ruid, boolean locked)
		-- 액션 표 항목 하나를 만든다.
		return {
			ActionID = actionId,
			Hotkey = hotkey,
			Label = label,
			Ruid = ruid or "",
			Locked = locked,
			LockReason = "",
			UnitModel = "",
			Building = nil,
			BuildData = {},
			Arg = "",
		}
	end

	@ExecSpace("ClientOnly")
	method string PickRuid(string resourceKey, string fallback)
		-- UIResources에 값이 있으면 그걸, 없으면 fallback(각 액션 컴포넌트에 설정된 아이콘)을 쓴다.
		local r = _UIResources:GetRuid(resourceKey)
		if r ~= "" then return r end
		return fallback or ""
	end

	@ExecSpace("ClientOnly")
	method string StructureNameOf(string modelId)
		-- 건설 목록 칸 이름: 내 진영 Structure_Stat_DataSet의 Name(Model 키). 클라이언트에서 CSV를 한 번만 읽어 둔다.
		local camp = ""
		local lp = _UserService.LocalPlayer
		if isvalid(lp) then
			---@type PlayerInfo
			local pinfo = lp:GetComponent("script.PlayerInfo")
			if pinfo ~= nil then camp = pinfo.SelectedCamp or "" end
		end
		if camp == "" then return "" end
		if self._structNamesCamp ~= camp then
			self._structNamesCamp = camp
			self._structNames = {}
			local ds = "Adv_Structure_Stat_DataSet"
			if camp == "Cyg" then ds = "Cyg_Structure_Stat_DataSet" elseif camp == "Ede" then ds = "Res_Structure_Stat_DataSet" end
			local temp = _DataService:GetTable(ds)
			if temp ~= nil then
				for idx = 1, temp:GetRowCount() do
					local model = temp:GetCell(idx, "Model")
					if model ~= nil and model ~= "" then
						self._structNames[model] = temp:GetCell(idx, "Name") or ""
					end
				end
			end
		end
		return self._structNames[modelId] or ""
	end

	@ExecSpace("ClientOnly")
	method void RefreshCard()
		-- 선행 건물 완공/파괴 등으로 잠금 상태가 바뀌었을 때(Structure_Info.OnSyncProperty), 현재 모드와 위치 지정 대기를
		-- 유지한 채 카드 내용만 다시 만든다. 건설 목록이 열려 있으면 같은 목록을 다시 연다.
		if self.Mode == "sub" and isvalid(self.SubSource) and not _BuildModeLogic:IsWorkerBusy(self.SubSource) then
			self:OpenBuildListKind(self.SubSource, self.SubKind)
			return
		end
		self.Mode = "base"
		self.Actions = self:BuildForEntity(_SelectionLogic.Focus)
		self:Push()
	end

	@ExecSpace("ClientOnly")
	method void Rebuild()
		-- 현재 Focus 기준으로 기본 카드를 다시 만들어 화면에 반영한다. 진행 중이던 위치 지정 대기는 취소한다.
		self.Mode = "base"
		self:ClearPending()
		self.Actions = self:BuildForEntity(_SelectionLogic.Focus)
		self:Push()
	end

	@ExecSpace("ClientOnly")
	method void Push()
		-- 액션 표를 UnitActionUI(UnitActionSpriteChange)로 보낸다.
		local lp = _UserService.LocalPlayer
		if not isvalid(lp) then return end
		local evt = UnitActionChangeEvent()
		evt.ActionList = self.Actions
		lp:SendEvent(evt)
	end

	@ExecSpace("ClientOnly")
	method table BaseActionsOf(Entity e)
		-- 기존 ActionBase 계열(WorkerAction/HealerAction/StructureAction/RegionBuildAction)이 주는 액션 목록.
		local comp = e.ActionBase
		if comp == nil then return {} end
		return comp:ChangeActionUI() or {}
	end

	@ExecSpace("ClientOnly")
	method table BuildForEntity(Entity e)
		-- 대상 종류(영웅/일꾼/일반 유닛/건물/그 외)에 맞는 10칸 액션 표를 만든다. 내 것이 아니면 빈 표.
		local slots = {}
		if not isvalid(e) then return slots end
		local me = self:LocalUserId()
		
		---@type Structure_Info
		local sinfo = e:GetComponent("script.Structure_Info")
		if sinfo ~= nil then
			if sinfo.PlayerID ~= me or sinfo.IsDestroyed then return slots end
			local keys = _UnitCommandData.ProductionKeys
			local i = 0
			for _, a in ipairs(self:BaseActionsOf(e)) do
				if i >= 9 then break end
				i += 1
				local hotkey = keys[i] or ""
				local label = ""
				if a.ActionID == "Spawn" then
					local data = _UnitCommandData:GetUnitData(a.UnitModel)
					label = data ~= nil and data.Name or "생산"
				elseif a.ActionID == "OpenBuildList" then
					hotkey = "B"
					label = "건설"
					-- 세계수의 뿌리처럼 제자리 변환 건물이면 "전초지 변환"(헤네시스/페리온/엘리니아/커닝시티 전초지 중 선택).
					---@type RegionBuildAction
					local region = e:GetComponent("script.RegionBuildAction")
					if region ~= nil and region.ConvertInPlace then label = "전초지 변환" end
				elseif a.ActionID == "JobAdvance" then
					label = a.Label or "전직"
				else
					-- 본진 X(에르다 채집 건물 배치)처럼 툴팁 제목을 넘기는 버튼은 그 이름을 쓴다.
					label = a.TipTitle or "건설"
				end
				local act = self:MakeAction(a.ActionID, hotkey, label, a.Ruid, a.Locked == true)
				act.LockReason = a.LockReason or ""
				act.UnitModel = a.UnitModel or ""
				act.Building = a.Building
				act.BuildData = a.BuildData or {}
				-- 전직관 연구 버튼(JobAdvanceAction)이 넘기는 단계·비용·툴팁 정보도 그대로 옮긴다.
				act.Arg = a.Arg or ""
				act.Done = a.Done == true
				act.TipTitle = a.TipTitle
				act.TipInfo = a.TipInfo
				act.CostMeso = a.CostMeso
				act.CostErda = a.CostErda
				act.CostTime = a.CostTime
				slots[i] = act
			end
			-- 업그레이드 건물: 공격(W)/방어(A) 단계 연구 버튼(StructureBuffAura — 스타 포지처럼 W 무기 / A 방어구).
			---@type StructureBuffAura
			local upgrade = e:GetComponent("script.StructureBuffAura")
			if upgrade ~= nil then
				for _, a in ipairs(upgrade:GetUpgradeActions()) do
					if i >= 9 then break end
					i += 1
					local act = self:MakeAction("Upgrade", (a.Arg == "A") and "W" or "A", a.Label, a.Ruid, a.Locked == true)
					act.LockReason = a.LockReason or ""
					act.Building = e
					act.Arg = a.Arg
					act.Done = a.Done == true
					act.TipTitle = a.TipTitle
					act.TipInfo = a.TipInfo
					act.CostMeso = a.CostMeso
					act.CostErda = a.CostErda
					act.CostTime = a.CostTime
					slots[i] = act
				end
			end
			-- 건물에는 취소(파괴/환불) 액션을 두지 않는다.
			return slots
		end
		
		local uinfo = e.Unit_Info
		if uinfo == nil or uinfo.PlayerID ~= me or uinfo.IsDead then return slots end
		
		local isHero = e:GetComponent("script.HeroUnitSkill") ~= nil
		local data = _UnitCommandData:GetUnitData(uinfo.UnitModelKey)
		local isWorker = (data ~= nil and data.Worker) or uinfo.RoleKey == "Worker"
		
		slots[1] = self:MakeAction("Move", "M", "이동", self:PickRuid("CmdMove", ""), false)
		slots[2] = self:MakeAction("Stop", "S", "정지", self:PickRuid("CmdStop", ""), false)
		-- 일꾼도 공격할 수 있다(2026-10-06). 대기 중엔 스스로 싸우지 않고, A+땅(어택땅) 중에는 가는 길의 적과 싸운다(Weapon.AutoAcquire, 2026-10-07).
		-- 영웅은 기본 공격이 없어(스킬 전용) 영웅만 골랐을 때는 공격/순찰/위치 고수 칸을 비운다.
		-- 영웅과 일반 유닛을 함께 골랐으면(부대) 대표가 영웅이어도 A·H를 보여 준다 — 일반 유닛은 공격, 영웅은 그 지점으로 이동.
		local withArmy = isHero and self:SelectionHasArmy()
		-- 힐러(파란버섯·물도둑)는 공격하지 않는다(2026-10-07) — 공격할 수 있는 유닛이 함께 선택됐을 때만 A를 보여 준다.
		local canAttack = (not isHero and uinfo.RoleKey ~= "RangedHealer") or self:SelectionHasAttacker()
		if canAttack then
			slots[3] = self:MakeAction("Attack", "A", "공격", self:PickRuid("CmdAttack", ""), false)
		end
		-- 힐러만 골랐으면 싸우는 명령(공격·순찰·위치 고수)을 두지 않는다 — 회복 전용(2026-10-07). 이동·정지·치유만 남는다.
		local healerOnly = uinfo.RoleKey == "RangedHealer" and not self:SelectionHasAttacker()
		if ((not isWorker and not isHero) or withArmy) and not healerOnly then
			slots[4] = self:MakeAction("Patrol", "P", "순찰", self:PickRuid("CmdPatrol", ""), true)
		end
		-- 위치 고수(H): 영웅도 쓸 수 있다(2026-10-07) — 영웅은 이동·이동 예약을 멈추고 그 자리에 선다(스킬은 그대로 시전 가능).
		if (not isWorker or withArmy) and not healerOnly then
			slots[5] = self:MakeAction("Hold", "H", "위치 고수", self:PickRuid("CmdHold", ""), false)
		end
		
		if isHero then
			-- 영웅 스킬 Q~T. 전직 단계(PlayerInfo.JobTier)로 잠근다: 1차 Q, 2차 W, 3차 E, 4차 R, 5차 T(JobAdvanceLogic).
			local skillKeys = { "Q", "W", "E", "R", "T" }
			---@type HeroUnit
			local heroComp = e:GetComponent("script.HeroUnit")
			local heroId = (heroComp ~= nil) and heroComp.HeroId or ""
			for idx, k in ipairs(skillKeys) do
				local skillName = _JobAdvanceLogic:SkillName(heroId, k)
				local label = (skillName ~= "") and skillName or ("스킬 " .. k)
				local unlocked = _JobAdvanceLogic:IsKeyUnlocked(me, k)
				-- 스킬 아이콘(ikon)은 Hero_Skill_Asset_DataSet에서, 없으면 공용 영웅 스킬 아이콘.
				local skillIcon = _HeroSkillAssetLogic:GetIcon(heroId, k)
				local act = self:MakeAction("HeroSkill", k, label, (skillIcon ~= "") and skillIcon or self:PickRuid("CmdHeroSkill", ""), not unlocked)
				if not unlocked then act.LockReason = _JobAdvanceLogic:LockText(k) end
				act.Arg = k
				act.Building = e
				slots[5 + idx] = act
			end
			return slots
		end
		
		-- 6~9: 일꾼 명령 → 고유 능력 순서로 채운다.
		local extras = {}
		local base = {}
		for _, a in ipairs(self:BaseActionsOf(e)) do
			base[a.ActionID] = a
		end
		if isWorker then
			local b = base["OpenBuildList"]
			local act = self:MakeAction("OpenBuildList", "B", "기본 건설", self:PickRuid("CmdBuild", b ~= nil and b.Ruid or ""), b == nil)
			act.Building = e
			act.Arg = "basic"
			table.insert(extras, act)
			-- 고급 건물 목록이 따로 있는 일꾼(WorkerAction.AdvancedSlots)만 V 고급 건설 버튼을 둔다.
			---@type WorkerAction
			local wa = e:GetComponent("script.WorkerAction")
			if wa ~= nil and wa:HasAdvancedList() then
				-- 아이콘 = UIResources.CmdBuildAdvanced(황금 망치). 비워 두면 글자 "고급 건설"로 보여 B 버튼과 구분한다.
				act = self:MakeAction("OpenBuildList", "V", "고급 건설", self:PickRuid("CmdBuildAdvanced", ""), b == nil)
				act.Building = e
				act.Arg = "advanced"
				table.insert(extras, act)
			end
			local g = base["GatherMeso"]
			act = self:MakeAction("GatherMeso", "G", "채집", self:PickRuid("CmdGather", g ~= nil and g.Ruid or ""), g == nil)
			act.Building = e
			table.insert(extras, act)
			local returnLabel = (data ~= nil and data.ReturnLabel ~= "") and data.ReturnLabel or "자원 반환"
			table.insert(extras, self:MakeAction("ReturnCargo", "C", returnLabel, self:PickRuid("CmdReturn", ""), true))
		end
		local healShown = false
		if data ~= nil then
			for _, ab in ipairs(data.Abilities) do
				local act = nil
				if ab.Name == "치유" and base["Heal"] ~= nil then
					act = self:MakeAction("Heal", ab.Key, ab.Name, self:PickRuid("AbHeal", base["Heal"].Ruid), false)
					healShown = true
				elseif ab.Name == "수리" then
					act = self:MakeAction("Repair", ab.Key, ab.Name, self:PickRuid("CmdRepair", ""), true)
				else
					-- 능력별 아이콘 키(UnitCommandData의 Icon → UIResources)를 쓰고, 없으면 공용 기본 아이콘.
					-- 구현된 능력(UnitAbilityLogic.Def)은 열고, 아직 없는 능력(탑승·지뢰 등)은 잠금 유지.
					local supported = _UnitAbilityLogic:IsSupported(ab.Name)
					act = self:MakeAction("Ability", ab.Key, ab.Name, self:PickRuid(ab.Icon or "CmdAbility", self:PickRuid("CmdAbility", "")), not supported)
					act.Arg = ab.Name
					act.TipTitle = ab.Name
					local tip = ab.Desc or ""
					local state = _UnitAbilityLogic:ToggleStateText(uinfo, ab.Name)
					if state ~= "" then tip = tip .. " (지금 " .. state .. ")" end
					act.TipInfo = tip
				end
				act.Building = e
				table.insert(extras, act)
			end
		end
		if not healShown and base["Heal"] ~= nil then
			-- 시트에 없는(UnitModelKey가 비어 있는) 힐러도 기존 힐 버튼은 유지한다.
			local act = self:MakeAction("Heal", "L", "치유", self:PickRuid("AbHeal", base["Heal"].Ruid), false)
			act.Building = e
			table.insert(extras, act)
		end
		for idx, act in ipairs(extras) do
			if idx > 4 then break end
			slots[5 + idx] = act
		end
		slots[10] = self:CancelAction(e)
		return slots
	end

	@ExecSpace("ClientOnly")
	method boolean SelectionHasAttacker()
		-- 지금 선택에 공격할 수 있는 내 유닛(영웅·힐러 제외, 일꾼 포함)이 한 기라도 있는지.
		local drag = _SelectionLogic.Drag
		if not isvalid(drag) then return false end
		for _, u in pairs(drag.SelectedUnits) do
			if isvalid(u) and u.Entity:GetComponent("script.HeroUnitSkill") == nil and _SelectionLogic:IsMyAliveUnit(u.Entity) then
				local info = u.Entity.Unit_Info
				if info ~= nil and info.RoleKey ~= "RangedHealer" then return true end
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method boolean SelectionHasArmy()
		-- 지금 선택에 영웅이 아닌 내 유닛(일꾼 포함)이 한 기라도 있는지.
		local drag = _SelectionLogic.Drag
		if not isvalid(drag) then return false end
		for _, u in pairs(drag.SelectedUnits) do
			if isvalid(u) and u.Entity:GetComponent("script.HeroUnitSkill") == nil and _SelectionLogic:IsMyAliveUnit(u.Entity) then
				return true
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method table CancelAction(Entity target)
		-- 내 소유의 건물(본진 제외)이면 "취소"(환불) 액션, 아니면 nil. 실수로 누르지 않게 단축키는 두지 않는다.
		-- 2026-10-07: 유닛 취소(즉사 + 환불 = 자살) 기능 제거 — 유닛에는 취소 칸을 두지 않는다.
		if not isvalid(target) then return nil end
		if target:GetComponent("script.HeroUnitSkill") ~= nil then return nil end
		local uinfo = target.Unit_Info
		if uinfo ~= nil then
			return nil
		else
			---@type Structure_Info
			local sinfo = target:GetComponent("script.Structure_Info")
			if sinfo == nil or sinfo.IsDestroyed or sinfo.BuildingKey == "HQ" then return nil end
		end
		local act = self:MakeAction("Cancel", "", "취소", self:PickRuid("CmdCancel", ""), false)
		act.Building = target
		return act
	end

	@ExecSpace("ClientOnly")
	method void OpenBuildList(Entity source)
		-- 기본 건설 목록을 연다(OpenBuildListKind "basic").
		self:OpenBuildListKind(source, "basic")
	end

	@ExecSpace("ClientOnly")
	method void OpenBuildListKind(Entity source, string kind)
		-- 건설 버튼(B 기본 / V 고급): source(일꾼 또는 영역 건물)의 건설 가능 목록을 하위 카드로 펼친다. 10번 칸은 뒤로(ESC).
		-- 일꾼은 kind로 기본/고급 목록을 나눠 보여 준다(WorkerAction.AdvancedSlots). 영역 건물은 kind와 무관하게 전체 목록.
		if not isvalid(source) then return end
		if _BuildModeLogic:IsWorkerBusy(source) then
			_UIToast_:ShowMessage("건설 중인 일꾼은 새 건물을 지을 수 없습니다")
			return
		end
		local buildList = nil
		-- 영역 전개처럼 목록 건물로 "변환"되는 건물(RegionBuildAction.ConvertInPlace)이면 칸이 배치 대신 변환(ConvertBuilding)을 실행한다.
		local itemActionId = "PlaceBuilding"
		---@type WorkerAction
		local worker = source:GetComponent("script.WorkerAction")
		if worker ~= nil then
			buildList = worker:GetBuildListKind(kind)
		else
			---@type RegionBuildAction
			local region = source:GetComponent("script.RegionBuildAction")
			if region ~= nil then
				buildList = region:GetBuildList()
				if region.ConvertInPlace then itemActionId = "ConvertBuilding" end
			end
		end
		if buildList == nil then return end
		
		local keys = _UnitCommandData.ProductionKeys
		local slots = {}
		for i, item in ipairs(buildList) do
			if i > 9 then
				break
			end
			local act = self:MakeAction(itemActionId, keys[i] or "", self:StructureNameOf(item.Model), item.Ruid, item.Locked == true)
			act.LockReason = item.LockReason or ""
			act.LockToast = item.LockToast or ""
			act.UnitModel = item.Model
			act.Building = source
			act.BuildData = item
			slots[i] = act
		end
		slots[10] = self:MakeAction("Back", "ESC", "뒤로", self:PickRuid("CmdBack", ""), false)
		self.Mode = "sub"
		self.SubSource = source
		self.SubKind = kind
		self.Actions = slots
		self:Push()
	end

	@ExecSpace("ClientOnly")
	method void ExecuteSlot(integer index, boolean fromHotkey)
		-- index번 칸의 액션을 실행한다(버튼 클릭은 fromHotkey=false, 단축키는 true).
		self:Execute(self.Actions[index], fromHotkey)
	end

	@ExecSpace("ClientOnly")
	method boolean HandleHotkey(string keyName)
		-- 단축키 글자(keyName)가 현재 카드의 어떤 칸에 붙어 있으면 그 칸을 실행하고 true.
		if keyName == "" or _BuildModeLogic.IsPlacing then return false end
		for i = 1, self.SlotCount do
			local a = self.Actions[i]
			if a ~= nil and a.Hotkey == keyName then
				self:Execute(a, true)
				return true
			end
		end
		return false
	end

	@ExecSpace("ClientOnly")
	method void Escape()
		-- ESC: 위치 지정 대기 → 힐/채집 대상 지정 대기 → 하위 카드 순으로 한 단계씩 취소한다.
		if self.PendingCommand ~= "" then
			self:ClearPending()
			_UIToast_:ShowMessage("명령을 취소했습니다")
			return
		end
		if _HealTargetLogic.IsTargeting then
			_HealTargetLogic:EndTargeting()
			_UIToast_:ShowMessage("명령을 취소했습니다")
			return
		end
		if _GatherTargetLogic.IsTargeting then
			_GatherTargetLogic:EndTargeting()
			_UIToast_:ShowMessage("명령을 취소했습니다")
			return
		end
		if self.Mode == "sub" then
			self:Rebuild()
		end
	end

	@ExecSpace("ClientOnly")
	method void ClearPending()
		-- 위치 지정 대기를 끝낸다.
		self.PendingCommand = ""
		self.PendingArg = ""
	end

	@ExecSpace("ClientOnly")
	method void BeginPending(string command, string arg, string message)
		-- 다음 우클릭 위치로 실행할 명령을 기다린다(Mouse_Command.FindTarget이 소비).
		self.PendingCommand = command
		self.PendingArg = arg
		if message ~= "" then _UIToast_:ShowMessage(message) end
	end

	@ExecSpace("ClientOnly")
	method void Execute(table a, boolean fromHotkey)
		-- 액션 하나를 실행한다. 잠긴 칸(게임 로직이 아직 없는 명령)은 안내 토스트만 띄운다.
		if a == nil then return end
		if a.Done == true then
			_UIToast_:ShowMessage((a.ActionID == "Upgrade") and "이미 최대 단계입니다" or "이미 완료한 전직입니다")
			return
		end
		if a.Locked then
			if a.LockToast ~= nil and a.LockToast ~= "" then
				_UIToast_:ShowMessage(a.LockToast)
				return
			end
			if a.LockReason ~= nil and a.LockReason ~= "" then
				_UIToast_:ShowMessage(a.LockReason .. " 필요")
				return
			end
			local key = (a.Hotkey ~= "" and (" (" .. a.Hotkey .. ")") or "")
			_UIToast_:ShowMessage(a.Label .. key .. " — 아직 준비 중인 기능입니다")
			return
		end
		local id = a.ActionID
		if id == "Move" then
			self:BeginPending("Move", "", "이동할 위치를 우클릭하세요 (ESC 취소)")
		elseif id == "Stop" then
			self:StopSelected()
		elseif id == "Attack" then
			-- 스타식 어택: A 다음 클릭(좌/우) 위치로 실행 — 적을 누르면 그 대상 공격, 땅을 누르면 어택땅(가는 길의 적과 교전).
			self:BeginPending("AttackMove", "", "")  -- 토스트 대신 공격 커서(CursorLogic)로 알린다
		elseif id == "Hold" then
			self:HoldSelected()
		elseif id == "HeroSkill" then
			if fromHotkey then
				-- 단축키는 기존처럼 즉시 커서 위치를 조준점으로 시전한다.
				self:CastHeroSkill(a.Arg, _UILogic:ScreenToWorldPosition(_InputService:GetCursorPosition()))
			else
				-- 버튼은 커서가 버튼 위에 있으므로 다음 우클릭 위치를 조준점으로 쓴다.
				self:BeginPending("HeroSkill", a.Arg, "스킬 " .. a.Arg .. " — 조준할 위치를 우클릭하세요 (ESC 취소)")
			end
		elseif id == "OpenBuildList" then
			self:OpenBuildListKind(a.Building, (a.Arg == "advanced") and "advanced" or "basic")
		elseif id == "JobAdvance" then
			if not isvalid(a.Building) then return end
			_JobAdvanceLogic:RequestResearch(a.Building, math.floor(tonumber(a.Arg) or 0))
		elseif id == "Ability" then
			-- 위치 지정형 능력: 단축키는 커서 위치로 즉시(영웅 스킬과 같은 규칙), 버튼은 다음 클릭 위치. 나머지는 즉시 시전.
			if _UnitAbilityLogic:NeedsAim(a.Arg) then
				if fromHotkey then
					self:CastAbility(a.Arg, _UILogic:ScreenToWorldPosition(_InputService:GetCursorPosition()))
				else
					self:BeginPending("Ability", a.Arg, "")
				end
			else
				self:CastAbility(a.Arg, Vector2(0, 0))
			end
		elseif id == "Upgrade" then
			if not isvalid(a.Building) then return end
			---@type StructureBuffAura
			local upgrade = a.Building:GetComponent("script.StructureBuffAura")
			if upgrade ~= nil then
				upgrade:RequestResearch(a.Arg)
			end
		elseif id == "Back" then
			self:Rebuild()
		elseif id == "Spawn" then
			_UserService.LocalPlayer.SpawnUnit:RequestSpawnUnit(a.UnitModel, a.Building)
		elseif id == "PlaceBuilding" then
			_BuildModeLogic:StartPlacement(a.Building, a.BuildData)
		elseif id == "ConvertBuilding" then
			-- a.Building은 변환될 건물(영역 전개), a.UnitModel은 고른 변환 대상 건물. 서버가 검증·결제 후 변환한다.
			if not isvalid(a.Building) or a.UnitModel == "" then return end
			_UserService.LocalPlayer.SpawnUnit:RequestConvertStructure(a.Building, a.UnitModel)
			-- 대상이 곧 바뀌므로 카드를 비운다.
			self.Actions = {}
			self:Push()
		elseif id == "Heal" then
			if not isvalid(a.Building) then return end
			_HealTargetLogic:BeginTargeting(a.Building)
			_UIToast_:ShowMessage("치유할 아군을 우클릭하세요")
		elseif id == "GatherMeso" then
			if not isvalid(a.Building) then return end
			if _BuildModeLogic:IsWorkerBusy(a.Building) then
				_UIToast_:ShowMessage("건설 중인 일꾼은 메소를 채집할 수 없습니다")
				return
			end
			if not _GatherTargetLogic:BeginTargeting(a.Building) then
				return
			end
			_UIToast_:ShowMessage("채집할 메소 광맥을 우클릭하세요")
		elseif id == "Cancel" then
			if not isvalid(a.Building) then return end
			_UserService.LocalPlayer.SpawnUnit:RequestCancelEntity(a.Building)
			-- 대상이 곧 사라지므로 카드를 비운다.
			self.Actions = {}
			self:Push()
		else
		end
	end

	@ExecSpace("ClientOnly")
	method void StopSelected()
		-- 선택된 유닛 전체 정지(건설에 묶인 일꾼 제외). 기존 Keyboard_Command.Stop과 동일.
		local drag = _SelectionLogic.Drag
		if not isvalid(drag) then return end
		for _, unit in pairs(drag.SelectedUnits) do
			if isvalid(unit) and not _BuildModeLogic:IsWorkerBusy(unit.Entity) then
				unit:RequestStop()
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void AttackSelected()
		-- (호환용) Keyboard_Command.Attack — A 단축키와 같은 어택 대기 상태로 들어간다.
		self:BeginPending("AttackMove", "", "")
	end

	@ExecSpace("ClientOnly")
	method void CastAbility(string abilityName, Vector2 aimWorldPos)
		-- 선택된 유닛 중 이 능력을 가진 유닛 전원에게 시전을 요청한다(재사용 대기 중인 유닛은 서버가 거절).
		local drag = _SelectionLogic.Drag
		if not isvalid(drag) then return end
		local n = 0
		for _, unit in pairs(drag.SelectedUnits) do
			if isvalid(unit) and not _BuildModeLogic:IsWorkerBusy(unit.Entity) then
				local info = unit.Entity.Unit_Info
				if info ~= nil and _UnitAbilityLogic:FindAbility(info, abilityName) ~= nil then
					info:RequestAbility(abilityName, aimWorldPos)
					n += 1
				end
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void HoldSelected()
		-- H 위치 고수: 선택된 유닛(건설에 묶인 일꾼 제외)이 그 자리에 멈춰 선다 — 공격하지 않음(2026-10-07).
		local drag = _SelectionLogic.Drag
		if not isvalid(drag) then return end
		for _, unit in pairs(drag.SelectedUnits) do
			if isvalid(unit) and not _BuildModeLogic:IsWorkerBusy(unit.Entity) then
				unit.Entity.Unit_Info:RequestHold()
			end
		end
	end

	@ExecSpace("ClientOnly")
	method void CastHeroSkill(string skillKey, Vector2 aimWorldPos)
		-- 선택된 영웅 유닛 전원에게 aimWorldPos 조준으로 스킬 시전을 요청한다. 기존 Keyboard_Command.CastHeroSkill과 동일.
		local drag = _SelectionLogic.Drag
		if not isvalid(drag) then return end
		for _, unit in pairs(drag.SelectedUnits) do
			if isvalid(unit) then
				---@type HeroUnitSkill
				local heroSkill = unit.Entity:GetComponent("script.HeroUnitSkill")
				if heroSkill ~= nil then
					heroSkill:RequestCast(skillKey, aimWorldPos)
				end
			end
		end
	end

end