	method table ChangeActionUI()
		-- 일꾼이 아니면(RoleKey ~= "Worker") 액션을 노출하지 않는다.
		local info = self.Entity.Unit_Info
		if info == nil or info.RoleKey ~= "Worker" then
			return {}
		end
		
		return {
			{
				ActionID = "OpenBuildList",
				UnitModel = "",
				Ruid = self.BuildButtonRuid,
				-- 어느 일꾼이 건설 버튼을 눌렀는지 알아야 그 일꾼의 건설 목록(GetBuildList)을 읽을 수 있다.
				Building = self.Entity,
			},
			{
				ActionID = "GatherMeso",
				UnitModel = "",
				Ruid = self.GatherButtonRuid,
				-- 어느 일꾼이 채집 버튼을 눌렀는지 알아야 그 일꾼의 WorkerGatherComponent에 채집을 지시할 수 있다.
				Building = self.Entity,
			},
		}
	end

	method table GetBuildList()
		-- 버튼 클릭 시(UIButtonAction) 호출되어, 이 일꾼이 지을 수 있는 건물 목록을 반환한다.
		-- BuildCondition이 있는 슬롯은 그 이름의 건물을 소유자가 이미 지어뒀을 때만 목록에 포함한다.
		local slots = {
			{ self.BuildModel1, self.BuildRuid1, self.BuildSizeX1, self.BuildSizeY1, self.BuildScaleX1, self.BuildScaleY1, self.BuildTime1, self.BuildCondition1 },
			{ self.BuildModel2, self.BuildRuid2, self.BuildSizeX2, self.BuildSizeY2, self.BuildScaleX2, self.BuildScaleY2, self.BuildTime2, self.BuildCondition2 },
			{ self.BuildModel3, self.BuildRuid3, self.BuildSizeX3, self.BuildSizeY3, self.BuildScaleX3, self.BuildScaleY3, self.BuildTime3, self.BuildCondition3 },
			{ self.BuildModel4, self.BuildRuid4, self.BuildSizeX4, self.BuildSizeY4, self.BuildScaleX4, self.BuildScaleY4, self.BuildTime4, self.BuildCondition4 },
			{ self.BuildModel5, self.BuildRuid5, self.BuildSizeX5, self.BuildSizeY5, self.BuildScaleX5, self.BuildScaleY5, self.BuildTime5, self.BuildCondition5 },
			{ self.BuildModel6, self.BuildRuid6, self.BuildSizeX6, self.BuildSizeY6, self.BuildScaleX6, self.BuildScaleY6, self.BuildTime6, self.BuildCondition6 },
			{ self.BuildModel7, self.BuildRuid7, self.BuildSizeX7, self.BuildSizeY7, self.BuildScaleX7, self.BuildScaleY7, self.BuildTime7, self.BuildCondition7 },
			{ self.BuildModel8, self.BuildRuid8, self.BuildSizeX8, self.BuildSizeY8, self.BuildScaleX8, self.BuildScaleY8, self.BuildTime8, self.BuildCondition8 },
			{ self.BuildModel9, self.BuildRuid9, self.BuildSizeX9, self.BuildSizeY9, self.BuildScaleX9, self.BuildScaleY9, self.BuildTime9, self.BuildCondition9 },
			{ self.BuildModel10, self.BuildRuid10, self.BuildSizeX10, self.BuildSizeY10, self.BuildScaleX10, self.BuildScaleY10, self.BuildTime10, self.BuildCondition10 },
			{ self.BuildModel11, self.BuildRuid11, self.BuildSizeX11, self.BuildSizeY11, self.BuildScaleX11, self.BuildScaleY11, self.BuildTime11, self.BuildCondition11 },
			{ self.BuildModel12, self.BuildRuid12, self.BuildSizeX12, self.BuildSizeY12, self.BuildScaleX12, self.BuildScaleY12, self.BuildTime12, self.BuildCondition12 },
			{ self.BuildModel13, self.BuildRuid13, self.BuildSizeX13, self.BuildSizeY13, self.BuildScaleX13, self.BuildScaleY13, self.BuildTime13, self.BuildCondition13 },
			{ self.BuildModel14, self.BuildRuid14, self.BuildSizeX14, self.BuildSizeY14, self.BuildScaleX14, self.BuildScaleY14, self.BuildTime14, self.BuildCondition14 },
			{ self.BuildModel15, self.BuildRuid15, self.BuildSizeX15, self.BuildSizeY15, self.BuildScaleX15, self.BuildScaleY15, self.BuildTime15, self.BuildCondition15 },
			{ self.BuildModel16, self.BuildRuid16, self.BuildSizeX16, self.BuildSizeY16, self.BuildScaleX16, self.BuildScaleY16, self.BuildTime16, self.BuildCondition16 },
			{ self.BuildModel17, self.BuildRuid17, self.BuildSizeX17, self.BuildSizeY17, self.BuildScaleX17, self.BuildScaleY17, self.BuildTime17, self.BuildCondition17 },
		}
		
		local map = self.Entity.CurrentMap
		---@type Unit_Info
		local info = self.Entity.Unit_Info
		local playerId = (info ~= nil) and info.PlayerID or ""
		
		local list = {}
		-- 본진(세계수 등)이 파괴되면 건설 목록 자체를 비운다(빈 목록이면 BuildListUI가 닫힘).
		if not _BuildRequirementLogic:HasAliveStructure(map, playerId, self.HQCondition) then
			return list
		end
		for slotIndex, slot in ipairs(slots) do
			if slot[1] ~= "" then
				-- 선행 건물이 없으면 숨기지 않고 잠금으로 넣는다(커맨드카드가 회색 + 필요한 건물 이름으로 표시).
				local unlocked = _BuildRequirementLogic:HasAliveStructure(map, playerId, slot[8])
				local lockReason = ""
				if not unlocked then lockReason = _BuildRequirementLogic:GetRequirementText(slot[8]) end
				-- 전직관은 플레이어당 하나만 지을 수 있다(이미 있으면 잠금 + 안내 문구).
				local lockToast = ""
				if unlocked and _JobAdvanceLogic:IsInstructorModel(slot[1]) and _JobAdvanceLogic:HasInstructor(map, playerId) then
					unlocked = false
					lockToast = "전직관은 하나만 지을 수 있습니다"
				end
				table.insert(list, {
					Model = slot[1],
					Ruid = slot[2],
					SizeX = slot[3],
					SizeY = slot[4],
					ScaleX = slot[5],
					ScaleY = slot[6],
					BuildTime = slot[7],
					Locked = not unlocked,
					LockReason = lockReason,
					SlotIndex = slotIndex,
					LockToast = lockToast,
				})
			end
		end
		return list
	end

	method boolean IsAdvancedSlot(integer slotIndex)
		-- slotIndex번 건설 슬롯이 고급 건설(V) 목록에 속하는지(AdvancedSlots에 번호가 있으면).
		if self.AdvancedSlots == "" then return false end
		for part in string.gmatch(self.AdvancedSlots, "[^,]+") do
			if tonumber(part) == slotIndex then return true end
		end
		return false
	end

	method boolean HasAdvancedList()
		-- 고급 건설(V) 목록이 따로 있는 일꾼인지.
		return self.AdvancedSlots ~= ""
	end

	method table GetBuildListKind(string kind)
		-- 커맨드카드용: kind = "basic"(B 기본 건설) / "advanced"(V 고급 건설)로 나눈 건설 목록. 스타 SCV·프로브 방식.
		local all = self:GetBuildList()
		if not self:HasAdvancedList() then return all end
		local want = (kind == "advanced")
		local out = {}
		for _, item in ipairs(all) do
			if self:IsAdvancedSlot(item.SlotIndex or 0) == want then table.insert(out, item) end
		end
		return out
	end

	method any GetConditionForModel(string modelId)
		-- 서버 재검증용: 건설 슬롯 중 modelId의 선행 건물 조건 문자열. 슬롯에 없는 모델이면 nil.
		local slots = {
			{ self.BuildModel1, self.BuildCondition1 },
			{ self.BuildModel2, self.BuildCondition2 },
			{ self.BuildModel3, self.BuildCondition3 },
			{ self.BuildModel4, self.BuildCondition4 },
			{ self.BuildModel5, self.BuildCondition5 },
			{ self.BuildModel6, self.BuildCondition6 },
			{ self.BuildModel7, self.BuildCondition7 },
			{ self.BuildModel8, self.BuildCondition8 },
			{ self.BuildModel9, self.BuildCondition9 },
			{ self.BuildModel10, self.BuildCondition10 },
			{ self.BuildModel11, self.BuildCondition11 },
			{ self.BuildModel12, self.BuildCondition12 },
			{ self.BuildModel13, self.BuildCondition13 },
			{ self.BuildModel14, self.BuildCondition14 },
			{ self.BuildModel15, self.BuildCondition15 },
			{ self.BuildModel16, self.BuildCondition16 },
			{ self.BuildModel17, self.BuildCondition17 },
		}
		for _, slot in ipairs(slots) do
			if slot[1] ~= "" and slot[1] == modelId then return slot[2] or "" end
		end
		return nil
	end

end