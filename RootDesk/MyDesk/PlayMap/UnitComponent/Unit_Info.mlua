@Component
script Unit_Info extends Component

	@Sync
	property boolean IsDead = false

	@Sync
	property number AttackCoolTime = 2

	@Sync
	property integer Hp = 0

	@Sync
	property integer MaxHp = 0

	property Entity Weapon = nil

	property Entity target = nil

	property string modelID = ""

	@Sync
	property string UnitModelKey = ""

	@Sync
	property string PlayerID = ""

	property string Line = ""

	property number Meso = 0

	property number Erda = 0

	@Sync
	property number defense = 0

	@Sync
	property number baseDefense = 0

	@Sync
	property number damage = 0

	@Sync
	property number MoveSpeed = 0

	@Sync
	property number TargetRange = 0

	@Sync
	property boolean IsAerial = false

	@Sync
	property number AttackRange = 0

	@Sync
	property string AttackStyle = "melee"

	@Sync
	property string HitEffectRUID = ""

	@Sync
	property string ProjectileRUID = ""

	@Sync
	property number AoeRadius = 2.0

	@Sync
	property number ProjectileSpeed = 12

	@Sync
	property number HitEffectScale = 1.0

	@Sync
	property number ProjectileScale = 1.0

	property Entity PriorityHealTarget = nil

	@Sync
	property number Energy = 0

	@Sync
	property number MaxEnergy = 0

	@Sync
	property string RoleKey = ""

	@Sync
	property number AbilityValue = 0

	@Sync
	property number AbilityDuration = 0

	@Sync
	property number Vision = 4.5

	@Sync
	property boolean IsStealth = false

	@Sync
	property boolean IsDetector = false

	@Sync
	property number AbilityReadyAt = 0

	@Sync
	property number AbilityCdTotal = 0

	@Sync
	property string AbilityCdName = ""

	@Sync
	property boolean AbilityToggle = false

	@ExecSpace("ClientOnly")
	method void OnMapEnter(Entity enteredMap)
		--유닛 정보 설정--
	end

	method void OnBeginPlay()
		-- Weapon 자식 탐색은 서버(전투 판정)와 클라이언트(애니메이션/UI) 양쪽에서 필요하므로 ExecSpace를 두지 않는다.
		self.modelID = self.Entity.Id
		-- 클라이언트: 체력바/선택 테두리 자식(SelectRing/HpBarBg/HpBarFill)을 UnitOverlayLogic에 등록한다.
		if self:IsClient() then
			_UnitOverlayLogic:Register(self.Entity)
		end
		
		local Children = self.Entity.Children
		
		for _, Child in pairs(Children) do
			if not Child.TagComponent then
				continue
			end
			
			local tags = Child.TagComponent.Tags
			for _, tag in pairs (tags) do
				if tag == "Weapon" then
					self.Weapon = Child
					return
				end
			end
		end
	end

	@ExecSpace("ServerOnly")
	method void GetDamage(integer damage)
		-- 오라/특수능력 버프가 damage × 1.1 같은 소수 피해를 넘길 수 있다(StructureBuffAura, SpecialAbilityComponent) — Hp는 integer라 먼저 내림한다.
		damage = math.floor(damage)
		if self.IsDead or self.Hp <= 0 or damage <= 0 then return end
		if _UtilLogic.ElapsedSeconds < (self._T.immuneUntil or 0) then return end
		-- 피해를 방어력만큼 경감해 적용한다(Structure_Info.GetDamage와 동일한 공식 — 경감 후에도 최소
		-- 1의 피해는 항상 들어간다). 서버 권위: Hp/IsDead는 @Sync라 모든 클라이언트에 전파되고,
		-- 각 클라이언트의 UnitStateComponent가 Hp 감소/IsDead를 폴링해 피격/사망 모션을 재생한다.
		-- ⚠ defense 프로퍼티는 CSV/스폰 데이터로는 계속 채워지고 있었지만 이 메서드가 지금까지 damage를
		-- 그대로 빼기만 해 실제로는 전혀 반영되지 않고 있었다(헤네시스 업그레이드 건물의 방어 버프를
		-- 붙이며 발견 — 갑옷버섯 defense=3 등 이미 0이 아닌 유닛이 여럿 있어 이 수정으로 기존 전투 밸런스가
		-- 실제로 변한다).
		-- 방어 업그레이드(UpgradeLogic) 보너스를 더한다.
		local buffDef = 0
		if (self._T.buffDefUntil or 0) > _UtilLogic.ServerElapsedSeconds then buffDef = self._T.buffDef or 0 end
		-- 고유 능력 방어 버프(도발·방어·방어막, UnitAbilityLogic.AddDefenseBuff)도 더한다.
		local reduced = damage - math.floor(self.defense + _UpgradeLogic:DefenseBonus(self) + buffDef)
		if reduced < 1 then reduced = 1 end
		self.Hp = math.max(0, self.Hp - reduced)
		
		if self.Hp <= 0 and not self.IsDead then
			self.IsDead = true
			self:Stop()
			self.target = nil
			self.PriorityHealTarget = nil
			local move = self.Entity.UnitMoveComponent
			if isvalid(move) then move:Stop() end
			local gather = self.Entity:GetComponent("script.WorkerGatherComponent")
			if gather ~= nil then gather:CancelGather("", false) end
			-- 결과표: 소유자 "잃은 유닛" +1, 지금 피해를 준 플레이어 "처치" +1(MatchStatsLogic.SetAttacker).
			_MatchStatsLogic:OnUnitDied(self.PlayerID)
		end
	end

	@ExecSpace("ServerOnly")
	method void Heal(number amount)
		-- 체력을 amount만큼 회복시킨다. MaxHp(0이면 무제한)를 넘지 않고, 사망한 유닛은 회복하지 않는다.
		if self.IsDead or amount <= 0 then return end
		local newHp = self.Hp + math.floor(amount)
		if self.MaxHp > 0 and newHp > self.MaxHp then
			newHp = self.MaxHp
		end
		self.Hp = newHp
	end

	method boolean IsOwnedBy(string userId)
		-- 이 유닛의 소유자가 userId인지 확인한다(클라이언트 명령 RPC의 권한 검사용).
		return not self.IsDead and self.PlayerID ~= "" and self.PlayerID == userId
	end

	method boolean CanAttackAerial()
		-- CSV 'Target' 열 값이 정확히 2인 유닛만 공중 유닛을 공격 대상으로 삼을 수 있다.
		-- 그 외 값(0/1/-1 등)은 모두 지상 대상만 공격 가능하다.
		return self.TargetRange == 2
	end

	method boolean CanTargetForCombat(Entity defender)
		-- 서버 명령과 실제 타격이 같은 적아군·생존·맵·대공 조건을 사용한다.
		if self.IsDead or not isvalid(defender) or defender == self.Entity then return false end
		if defender.CurrentMap ~= self.Entity.CurrentMap then return false end
		if defender:GetComponent("script.MesoStructure") ~= nil then return false end
		local defInfo = defender.Unit_Info
		if defInfo ~= nil then
			if defInfo.IsDead or (self.PlayerID ~= "" and defInfo.PlayerID == self.PlayerID) then return false end
			-- 은신 유닛은 내(소유자) 탐지기(소울/영웅/Tech·FinalTech 건물) 반경 안에 있을 때만 공격 대상이 된다
			-- (Vision-Spec-20261004.md §8-1). 은신 유닛이 공격해도 드러나지 않는다(§8-2) — 여기서 노출 처리를 하지 않는다.
			if defInfo.IsStealth and not _VisionLogic:IsDetectedBy(self.PlayerID, defender) then return false end
			return not defInfo.IsAerial or self:CanAttackAerial()
		end
		local structure = defender:GetComponent("script.Structure_Info")
		local companion = defender:GetComponent("script.UnitHitComponent")
		if companion ~= nil then return _CombatTeamLogic:IsEnemy(self.Entity, defender) end
		return structure ~= nil and not structure.IsDestroyed and (self.PlayerID == "" or structure.PlayerID ~= self.PlayerID)
	end

	@ExecSpace("Server")
	method void RequestSetTarget(Entity newTarget)
		-- 소유 클라이언트(Mouse_Command 우클릭)가 지정한 공격 대상을 서버에 기록한다. target은 서버 전투 판정에서만 쓴다.
		if not self:IsOwnedBy(senderUserId) then return end
		if _BuildModeLogic:IsWorkerBusy(self.Entity) then return end
		_BuildModeLogic:CancelBuildOrder(self.Entity)
		if newTarget ~= nil and not self:CanTargetForCombat(newTarget) then
			return
		end
		local adapter = self.Entity:GetComponent("script.HeroUnitSkill")
		if adapter ~= nil then
			-- 영웅은 기본 공격 없이 스킬로만 싸운다(2026-10-06) — 적을 우클릭하면 그 위치로 이동만 한다.
			self._T.amDest = nil
			self._T.hold = false
			self.PriorityHealTarget = nil   -- 다른 명령은 치유 대상 지정을 푼다(2026-10-07)
			if newTarget ~= nil then
				local tp = newTarget.TransformComponent.WorldPosition
				local dest = Vector2(tp.x, tp.y)
				if adapter:QueueMove(dest) then return end
				self:Stop()
				self.target = nil
				local move = self.Entity.UnitMoveComponent
				if isvalid(move) then move:FindTarget(dest) end
			end
			return
		end
		if self.damage <= 0 and newTarget ~= nil then
			-- 공격력이 없는 유닛(파란버섯·물도둑 힐러, 2026-10-07)은 싸우지 않는다. 부대가 적을 공격 지정받으면
			-- 힐러는 "치유하며 따라가기"로 바꾼다: 적 바로 앞이 아니라 HealerTrailDistance(2.5)칸 뒤 지점을 목적지로 잡고,
			-- 가는 동안 다친 아군이 곁에 있으면 멈춰서 치유한다(SpecialAbilityComponent.TickHeal — _T.amDest 사용).
			-- 예전엔 적이 있는 위치로 곧장 걸어가 앞장서다 죽었다.
			self._T.hold = false
			self.PriorityHealTarget = nil   -- 다른 명령은 치유 대상 지정을 푼다(2026-10-07)
			self:Stop()
			self.target = nil
			local tp = newTarget.TransformComponent.WorldPosition
			local mp = self.Entity.TransformComponent.WorldPosition
			local dest = Vector2(tp.x, tp.y)
			local dx, dy = tp.x - mp.x, tp.y - mp.y
			local dist = math.sqrt(dx * dx + dy * dy)
			local trail = 2.5
			if dist > trail then
				dest = Vector2(tp.x - dx / dist * trail, tp.y - dy / dist * trail)
			else
				dest = Vector2(mp.x, mp.y)
			end
			self._T.amDest = dest
			local move = self.Entity.UnitMoveComponent
			if isvalid(move) then move:FindTarget(dest) end
			return
		end
		local gather = self.Entity:GetComponent("script.WorkerGatherComponent")
		if gather ~= nil then gather:CancelByCommand() end
		self:Stop()
		self.target = newTarget
		-- 새 직접 명령이므로 어택땅/위치 고수 상태는 끝낸다.
		self._T.amDest = nil
		self._T.hold = false
		self.PriorityHealTarget = nil   -- 다른 명령은 치유 대상 지정을 푼다(2026-10-07)
		-- 우클릭으로 적을 지정하면 바로 공격(추격)을 시작한다(2026-10-06: 예전엔 대상만 저장하고 A를 따로 눌러야 공격했음).
		if newTarget ~= nil then
			local move = self.Entity.UnitMoveComponent
			if isvalid(move) then move:Stop() end
			self:Attack()
		end
	end

	@ExecSpace("Server")
	method void RequestAttackMove(Vector2 point)
		-- A + 땅 클릭(어택땅): point로 이동하면서 자동 교전 범위 안의 적을 만나면 싸우고, 처치 후 다시 point로 간다.
		-- 실제 교전/재개는 서버 Weapon.AutoAcquire가 _T.amDest를 보고 처리한다.
		if not self:IsOwnedBy(senderUserId) then return end
		if _BuildModeLogic:IsWorkerBusy(self.Entity) then return end
		if self._T.siege ~= nil then return end
		_BuildModeLogic:CancelBuildOrder(self.Entity)
		local adapter = self.Entity:GetComponent("script.HeroUnitSkill")
		if adapter ~= nil then adapter:ClearQueuedMove() end
		local gather = self.Entity:GetComponent("script.WorkerGatherComponent")
		if gather ~= nil then gather:CancelByCommand() end
		self:Stop()
		self.target = nil
		self._T.hold = false
		self.PriorityHealTarget = nil   -- 다른 명령은 치유 대상 지정을 푼다(2026-10-07)
		-- 영웅은 자동 교전을 하지 않으므로 어택땅도 일반 이동으로 처리한다.
		self._T.amDest = (adapter == nil) and point or nil
		local move = self.Entity.UnitMoveComponent
		if isvalid(move) then move:FindTarget(point) end
	end

	@ExecSpace("Server")
	method void RequestAbility(string abilityName, Vector2 aim)
		-- 소유 클라이언트(커맨드카드 고유 능력 칸)의 능력 시전 요청. 실제 처리는 UnitAbilityLogic(서버).
		if not self:IsOwnedBy(senderUserId) then return end
		if _BuildModeLogic:IsWorkerBusy(self.Entity) then return end
		_UnitAbilityLogic:Cast(self, abilityName, aim)
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		-- 능력 켜고 끄기가 바뀌면 이 유닛을 보고 있는 커맨드카드(툴팁의 켜짐/꺼짐)를 다시 만든다.
		if name == "AbilityToggle" and _SelectionLogic.Focus == self.Entity then
			_CommandCardLogic:RefreshCard()
		end
	end

	@ExecSpace("Server")
	method void RequestHold()
		-- H 위치 고수: 이동을 멈추고 공격도 하지 않은 채 그 자리에 서 있는다(2026-10-07 사용자 확정, Weapon.AutoAcquire가 _T.hold를 확인).
		-- 다른 명령(이동·정지·공격 대상 지정·어택땅)을 받으면 풀린다.
		if not self:IsOwnedBy(senderUserId) then return end
		if _BuildModeLogic:IsWorkerBusy(self.Entity) then return end
		_BuildModeLogic:CancelBuildOrder(self.Entity)
		local adapter = self.Entity:GetComponent("script.HeroUnitSkill")
		if adapter ~= nil then adapter:ClearQueuedMove() end
		local gather = self.Entity:GetComponent("script.WorkerGatherComponent")
		if gather ~= nil then gather:CancelByCommand() end
		local move = self.Entity.UnitMoveComponent
		if isvalid(move) then move:Stop() end
		self:Stop()
		self.target = nil
		self._T.amDest = nil
		self._T.hold = true
		self.PriorityHealTarget = nil   -- 다른 명령은 치유 대상 지정을 푼다(2026-10-07)
	end

	@ExecSpace("Server")
	method void RequestAttack()
		-- 소유 클라이언트(Keyboard_Command A키)의 공격 명령. 실제 공격/추격은 서버의 Weapon이 처리한다.
		if not self:IsOwnedBy(senderUserId) or self.IsDead then return end
		_BuildModeLogic:CancelBuildOrder(self.Entity)
		self:Attack()
	end

	@ExecSpace("Server")
	method void RequestSetPriorityHealTarget(Entity healTarget)
		-- 소유 클라이언트(힐 버튼 → 우클릭)가 지정한 우선 회복 대상. 요청자 소유의 살아있는 유닛만 허용한다.
		if not self:IsOwnedBy(senderUserId) or not isvalid(healTarget) then return end
		if healTarget.CurrentMap ~= self.Entity.CurrentMap then return end
		---@type Unit_Info
		local targetInfo = healTarget:GetComponent("script.Unit_Info")
		if targetInfo == nil or targetInfo.IsDead or not targetInfo:IsOwnedBy(senderUserId) then return end
		self.PriorityHealTarget = healTarget
	end

	@ExecSpace("ServerOnly")
	method void Attack()
		-- 영웅은 기본 공격이 없다(스킬 전용). 어떤 경로로 호출돼도 무기 공격을 시작하지 않는다.
		if self.Entity:GetComponent("script.HeroUnitSkill") ~= nil then return end
		if _CombatTeamLogic:IsActionLocked(self.Entity) then return end
		if self.IsDead or not self:CanTargetForCombat(self.target) then return end
		-- 건설에 묶인 일꾼(건설 이동 중/건설 중)은 어떤 경로로 호출돼도 공격을 시작하지 않는다.
		if _BuildModeLogic:IsWorkerBusy(self.Entity) then
			return
		end
		
		if not isvalid(self.Weapon) then
			return
		end
		
		if self.target == nil then
			return
		end
		
		local gather = self.Entity:GetComponent("script.WorkerGatherComponent")
		if gather ~= nil then gather:CancelByCommand() end
		self.Weapon.Weapon:AttackTarget(self.target)
	end

	@ExecSpace("ServerOnly")
	method void Stop()
		-- 정지 명령: 이동 정지는 UnitMoveComponent 가 처리하고, 전투(공격/추격) 취소는 여기서 Weapon 에 위임한다.
		if isvalid(self.Weapon) then
			---@type Weapon
			local weapon = self.Weapon:GetComponent("script.Weapon")
			if weapon ~= nil then weapon:CancelAttack() end
		end
	end

	@ExecSpace("ServerOnly")
	method void SetPlayerID(string UserID)
		self.PlayerID = UserID
	end

end