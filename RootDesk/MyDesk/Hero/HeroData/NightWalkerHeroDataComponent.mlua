	method integer ResolveBatBounceCount(integer unlockTier)
		    -- "1번 튕김"은 첫 대상 적중 후 추가로 1명에게 더 튄다는 뜻이다.
		    if unlockTier <= 0 then return 0 end
		    if unlockTier == 1 then return 1 end
		    if unlockTier == 2 then return 2 end
		    if unlockTier == 3 then return 3 end
		    return 4
	end

	method table BuildBatConfig(integer unlockTier)
		    -- 쉐도우 배트 수치의 단일 출처. 해금 단계(unlockTier)는 HeroSkillComponent의 nightWalkerBatUnlockTier가 넘겨준다.
		    -- W 해금부터 박쥐가 1마리씩 늘고, 튕김 횟수도 W=1 / E=2 / R=3 / T=4에 맞춘다.
		    return {
		        totalBats = unlockTier,
		        procChance = 0.3,
		        maxBounces = self:ResolveBatBounceCount(unlockTier),
		        bounceRadius = 2.8,
		        projectileSpeed = 16.5,
		        damageMultiplier = 0.55,
		        hitRadius = 0.48,
		        idleOffsets = {
		            Vector2(-0.28, 0.18),
		            Vector2(0.28, 0.14),
		            Vector2(-0.22, -0.08),
		            Vector2(0.22, -0.12),
		        },
		    }
	end

