@Component
script DarkKnightHeroDataComponent extends Component

	method table BuildKit()
		    return {
		        name = "다크나이트",
		        role = "전방 돌파/집결 해체 — 묵직한 창격으로 전열을 밀어내고 창선으로 후방까지 압박한다.",
		        passive = "리인카네이션: 부활 시 생존 보정. 사망/부활 파이프라인이 없으므로 현재는 TODO 설명 데이터다.",
		        -- 2차: 공식 리마스터 기준 적을 앞쪽으로 끌어오는 스피어 풀링. RTS에서는 빠른 전열 정리용 Q로 둔다.
		        Q = {
		            name = "스피어 풀링",
		            skillClass = "pull_line",
		            targetIntent = "many",
		            projectileCount = 0,
		            hitCount = 1,
		            burstCount = 0,
		            tickCount = 1,
		            shape = "front",
		            length = 5.1,
		            width = 1.65,
		            telegraphShape = "front",
		            telegraphLength = 5.1,
		            telegraphWidth = 1.65,
		            hitShape = "front",
		            hitLength = 5.1,
		            hitWidth = 1.65,
		            visualVsHitDelta = 0,
		            damage = 76,
		            cooldown = 1.8,
		            castWindup = 0.11,
		            pull = true,
		            stunDuration = 0.5,
		            emitImpactPerTarget = true,
		            pullSpeed = 8.4,
		            pullDuration = 0.22,
		            clientAttackMotion = true,
		            effectScaleMultiplier = 0.88,
		            -- 판정 범위는 내부 박스로만 쓰고 화면에는 드러내지 않는다.
		            telegraph = false,
		            telegraphTime = 0.14,
		        },
		        -- 3차: 라만차 스피어는 거대한 창을 휘두르며 돌파하는 기술이라, 넓은 전방 3연타로 구현한다.
		        W = {
		            name = "라만차 스피어",
		            skillClass = "sweep_channel",
		            targetIntent = "many",
		            projectileCount = 0,
		            hitCount = 3,
		            burstCount = 0,
		            tickCount = 3,
		            emitImpactPerTarget = true,
		            tickInterval = 0.18,
		            shape = "front",
		            length = 5.7,
		            width = 2.95,
		            telegraphShape = "front",
		            telegraphLength = 5.7,
		            telegraphWidth = 2.95,
		            hitShape = "front",
		            hitLength = 5.7,
		            hitWidth = 2.95,
		            visualVsHitDelta = 0,
		            damage = 94,
		            cooldown = 5.2,
		            castWindup = 0.17,
		            clientAttackMotion = true,
		            effectScaleMultiplier = 0.98,
		            -- 보이는 건 순수 시전 연출만, 실제 타격 범위는 숨긴다.
		            telegraph = false,
		            telegraphTime = 0.22,
		        },
		        -- 4차 주력: 궁니르 디센트는 공식 설명대로 신화 속의 창을 던지는 관통기다.
		        E = {
		            name = "궁니르 디센트",
		            skillClass = "spear_projectile",
		            targetIntent = "line",
		            projectile = true,
		            projectileCount = 1,
		            hitCount = 1,
		            burstCount = 0,
		            tickCount = 1,
		            shape = "front",
		            length = 7.6,
		            width = 0.95,
		            telegraphShape = "front",
		            telegraphLength = 7.6,
		            telegraphWidth = 0.95,
		            hitShape = "front",
		            hitLength = 7.6,
		            hitWidth = 0.95,
		            visualVsHitDelta = 0,
		            damage = 154,
		            cooldown = 3.3,
		            castWindup = 0.14,
		            projectileSpeed = 12.5,
		            projectileStartForwardOffset = 0.72,
		            clientAttackMotion = true,
		            effectScaleMultiplier = 0.82,
		            projectileScaleMultiplier = 0.82,
		            -- 창이 날아가는 연출과 별개로, 판정 박스는 숨긴 채 유지한다.
		            telegraph = false,
		            telegraphTime = 0.18,
		        },
		        -- 4차 광역: 다크 임페일은 "눈에 보이지 않을 정도로 빠르게" 찌르는 전방 다수기라서 짧고 빠른 일직선 강타로 맞춘다.
		        R = {
		            name = "다크 임페일",
		            skillClass = "heavy_line",
		            targetIntent = "many",
		            projectileCount = 0,
		            hitCount = 1,
		            burstCount = 0,
		            tickCount = 1,
		            shape = "front",
		            length = 5.5,
		            width = 1.9,
		            telegraphShape = "front",
		            telegraphLength = 5.5,
		            telegraphWidth = 1.9,
		            hitShape = "front",
		            hitLength = 5.5,
		            hitWidth = 1.9,
		            visualVsHitDelta = 0,
		            damage = 236,
		            cooldown = 7.8,
		            castWindup = 0.14,
		            clientAttackMotion = true,
		            effectForwardOffset = 1.10,
		            effectScaleMultiplier = 0.92,
		            -- 전방 박스 판정은 고정이지만 화면에는 노출하지 않는다.
		            telegraph = false,
		            telegraphTime = 0.18,
		        },
		        -- 5차: 피어스 사이클론은 시작 일격 → 유지 6틱 → 몸 앞에 붙은 창으로 마무리 강타를 찍는 구조다.
		        T = {
		            name = "피어스 사이클론",
		            skillClass = "short_channel",
		            targetIntent = "many",
		            projectileCount = 0,
		            hitCount = 8,
		            burstCount = 0,
		            tickCount = 7,
		            tickInterval = 0.24,
		            finalBurstDamage = 280,
		            -- 유지 타격이 끝난 직후 몸 앞에 붙은 창이 툭 떨어지듯 마무리되게 맞춘다.
		            finalBurstDelay = 2.22,
		            shape = "front",
		            length = 5.9,
		            width = 3.35,
		            telegraphShape = "front",
		            telegraphLength = 5.9,
		            telegraphWidth = 3.35,
		            hitShape = "front",
		            hitLength = 5.9,
		            hitWidth = 3.35,
		            visualVsHitDelta = 0,
		            damage = 116,
		            cooldown = 110,
		            castWindup = 0.22,
		            clientAttackMotion = true,
		            effectForwardOffset = 1.12,
		            effectScaleMultiplier = 0.92,
		            followCasterDuringChannel = true,
		            moveLockDuration = 4.02,
		            -- 채널링 범위도 내부 판정만 유지하고 시각적 범위 표시는 끈다.
		            telegraph = false,
		            telegraphTime = 0.32,
		        },
		    }
	end

	method table BuildVfx()
		    return {
		        -- effect: 시전 순간 이펙트
		        -- effect0/ball: 날아가는 투사체 비주얼
		        -- effect2/impact: 맞는 순간 또는 피니시 이펙트
		        -- telegraph: 실제 판정 범위를 보여주는 안내선
		        Q = {
		            effect = "15cdea54f3a04da89cf46aaa6fa1cf81",
		            stunEffect = "76dd9053eec5461cb953c900fea987b3",
		            effect2Delay = 0.08,
		            effect2ForwardOffset = 0.82,
		            sound = "248c6a07219145e98c9fe0518d2d8fcb",
		            impactSound = "be94be8751054cc4b0e45c0ea1833ff3",
		            telegraph = "15cdea54f3a04da89cf46aaa6fa1cf81",
		        },
		        -- W는 넓은 3연타라 첫 시전(effect)과 후속 강타(effect2)를 나눠 둔다.
		        W = {
		            effect = "36dcd96411b9479b8a3be63f513facb4",
		            impact = "389b0f3fdda0438caa06de6fe7691341", multiImpactEffect = "389b0f3fdda0438caa06de6fe7691341",
		            effect2Delay = 0.34,
		            effect2ForwardOffset = 1.08,
		            sound = "232056d88be8495f9f1f30fd2b58dff1",
		            impactSound = "24ba902c2b7d41209bd7ccf6f59aaaed",
		            telegraph = "36dcd96411b9479b8a3be63f513facb4",
		        },
		        -- E는 effect가 캐스트, effect0가 실제로 날아가는 창, impact가 도착 지점 폭발이다.
		        -- 시전 이펙트가 발밑 원점에 붙어 있어서 머리 위로 올린다(값은 Maker에서 보고 미세조정).
		        E = {
		            effect = "668e1de7954946c3a48f82fed4fafe74",
		            effectForwardOffset = 0,
		            effectVerticalOffset = 0.7,
		            effect0 = "9b8899ca8cb54d02926a1309dca73a5c",
		            impact = "1d89e334364e4fbb8d3b18ba65e2e967",
		            sound = "0ba58fe8a71b4cd2b5063fa598eab5a3",
		            impactSound = "168e2ba5d21644ceaeb5a7dadf106348",
		            telegraph = "668e1de7954946c3a48f82fed4fafe74",
		        },
		        -- R은 짧은 돌진 찌르기라 impact를 effect2로 둔다.
		        R = {
		            effect = "ed38cd53290046eb86ad9244632e950a",
		            effect2 = "25fece015d3c4a4f9aa7fb78eafc1076",
		            effect2Delay = 0.05,
		            effect2ForwardOffset = 1.16,
		            sound = "f9c8dd4041b943728b8556bc1302797e",
		            impactSound = "6313ad64a5854e20ab6e0e369e1c2c56",
		            telegraph = "ed38cd53290046eb86ad9244632e950a",
		        },
		        -- T는 시작(effect) → 유지(tickEffect) → 마무리(effect2) 구조다.
		        T = {
		            effect2 = "721e56745c554a439e51ee1eb004753a",
		            -- 마지막 창꽂기 이펙트는 적 위치가 아니라 시전자 몸 앞에 붙어 나온다.
		            impactUseCasterAnchor = true,
		            effect2Delay = 1.92,
		            effect2ForwardOffset = 1.52,
		            tickEffect = "b72d8158cef947999ac6ab72573ceeab",
		            visualTickCount = 6,
		            visualTickInterval = 0.24,
		            tickEffectForwardOffset = 1.12,
		            followCasterDuringChannel = true,
		            sound = "d3838d96937e4d599f8b739ca0b8df5b",
		            loopSound = "00ed2c2042764becba6f377eb893c51d",
		            impactSound = "885d4c90590a481687feeea62f74f5c2",
		            shake = true,
		            telegraph = "721e56745c554a439e51ee1eb004753a",
		        },
		    }
	end

end