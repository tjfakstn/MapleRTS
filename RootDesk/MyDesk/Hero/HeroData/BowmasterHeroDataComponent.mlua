@Component
script BowmasterHeroDataComponent extends Component

	method table BuildKit()
		    return {
		        name = "보우마스터",
		        role = "장거리 직접 조작 화력/사거리 압박 — 짧쿨 속사로 라인을 긁고 강한 일직선 화살과 화살비로 교전을 열어젖힌다.",
		        passive = "집중 사격: 설치기 의존 대신 전방 집중 화력 정체성을 유지한다. 관통/치명타 확장 파이프라인은 TODO다.",
		        -- Q는 애로우 블로우. 단발 화살 1발이 곧게 날아가며 가장 기본적인 평타 대용 스킬 역할을 맡는다.
		        Q = {
		            name = "애로우 블로우",
		            skillClass = "single_hit",
		            targetIntent = "few",
		            projectileCount = 1,
		            hitCount = 1,
		            burstCount = 0,
		            tickCount = 0,
		            shape = "front",
		            length = 7.3,
		            width = 0.92,
		            telegraphShape = "front",
		            telegraphLength = 7.3,
		            telegraphWidth = 0.92,
		            hitShape = "front",
		            hitLength = 7.3,
		            hitWidth = 0.92,
		            visualVsHitDelta = 0,
		            damage = 46,
		            cooldown = 1.1,
		            projectile = true,
		            castWindup = 0.08,
		            -- 활 쏘는 시전 모션이 다 재생된 뒤에 판정/피격이 들어가도록 한다.
		            -- 이 값이 실제 모션 길이보다 짧으면 모션 도중에 피격 이펙트가 겹쳐 보인다.
		            castMotionDuration = 0.32,
		            projectileFireDelay = 0.03,
		            projectileSpeed = 14.8,
		            projectileStartForwardOffset = 0.62,
		            -- 기본 화살 한 발만 보이고 실제 판정 범위는 숨긴다.
		            telegraph = false,
		            telegraphTime = 0.08,
		            effectScaleMultiplier = 0.7,
		            projectileScaleMultiplier = 0.86,
		            impactScaleMultiplier = 0.9,
		        },
		        -- W는 애로우 봄. 직선으로 날아간 화살이 적에게 닿으면 폭발 이펙트가 붙는 단일 강사격이다.
		        W = {
		            name = "애로우 봄",
		            skillClass = "single_hit",
		            targetIntent = "single",
		            projectileCount = 1,
		            hitCount = 1,
		            burstCount = 0,
		            tickCount = 0,
		            shape = "front",
		            length = 7.6,
		            width = 0.86,
		            telegraphShape = "front",
		            telegraphLength = 7.6,
		            telegraphWidth = 0.86,
		            hitShape = "front",
		            hitLength = 7.6,
		            hitWidth = 0.86,
		            visualVsHitDelta = 0,
		            damage = 104,
		            cooldown = 5.2,
		            projectile = true,
		            castWindup = 0.1,
		            projectileFireDelay = 0.04,
		            projectileSpeed = 13.6,
		            projectileStartForwardOffset = 0.68,
		            maxTargets = 1,
		            -- 마우스 방향으로 한 발만 곧게 날아가고, 맞은 적 위치에 폭발 이펙트만 남긴다.
		            telegraph = false,
		            telegraphTime = 0.1,
		            effectScaleMultiplier = 0.84,
		            projectileScaleMultiplier = 0.9,
		            impactScaleMultiplier = 0.96,
		        },
		        -- E는 언카운터블 애로우. 전방 넓은 범위를 순간적으로 긁는 즉발 난사형으로 단순화한다.
		        E = {
		            name = "언카운터블 애로우",
		            skillClass = "front_burst",
		            targetIntent = "many",
		            projectileCount = 0,
		            hitCount = 1,
		            burstCount = 0,
		            tickCount = 0,
		            shape = "front",
		            length = 7.2,
		            width = 2.8,
		            telegraphShape = "front",
		            telegraphLength = 7.2,
		            telegraphWidth = 2.8,
		            hitShape = "front",
		            hitLength = 7.2,
		            hitWidth = 2.8,
		            visualVsHitDelta = 0,
		            damage = 96,
		            cooldown = 7.3,
		            projectile = false,
		            castWindup = 0.14,
		            castMotionDuration = 0.42,
		            -- 상하/대각 회전 없이, 커서의 좌/우 위치에 따라서만 반전된다.
		            -- 즉발 범위기라 별도 화살 투사체는 쓰지 않는다.
		            telegraph = false,
		            telegraphTime = 0.14,
		            -- 전방을 넓게 긁는 난사형이라 판정을 키웠다(기존 3.6 x 1.4칸 -> 4.4 x 2.1칸).
		            effectBaseLength = 4.4,
		            effectBaseWidth = 2.1,
		            effectScaleMultiplier = 0.92,
		            impactScaleMultiplier = 0.9,
		        },
		        -- R은 폭풍의 시. 한 번 누르면 약 5초 동안 캐릭터에 붙어 이동하며 직선 화살을 연사한다.
		        R = {
		            name = "폭풍의 시",
		            skillClass = "short_channel",
		            targetIntent = "many",
		            projectileCount = 25,
		            hitCount = 25,
		            burstCount = 0,
		            tickCount = 25,
		            shape = "front",
		            length = 8.4,
		            width = 1.1,
		            telegraphShape = "front",
		            telegraphLength = 8.4,
		            telegraphWidth = 1.1,
		            hitShape = "front",
		            hitLength = 8.4,
		            hitWidth = 1.1,
		            visualVsHitDelta = 0,
		            damage = 30,
		            cooldown = 10.5,
		            projectile = true,
		            castWindup = 0.12,
		            projectileFireDelay = 0.02,
		            tickInterval = 0.2,
		            projectileSpeed = 18.2,
		            projectileStartForwardOffset = 0.74,
		            -- 화살이 발밑에서 나가 보여서 위로 올린다.
		            projectileVerticalOffset = 0.35,
		            useCurrentFacing = true,
		            followCasterDuringChannel = true,
		            followCasterAimDuringChannel = true,
		            -- 폭풍의 시 역시 조준 커서가 아니라 현재 바라보는 직선 방향으로만 나간다.
		            telegraph = false,
		            telegraphTime = 0.12,
		            effectBaseLength = 5.833,
		            effectBaseWidth = 0.764,
		            effectScaleMultiplier = 0.72,
		            projectileScaleMultiplier = 0.88,
		            impactScaleMultiplier = 0.9,
		        },
		        -- T는 잔영의 시. 몸은 따라가지만 첫 조준 각도는 유지하고, 좌/우 기준 최대 60도까지만 기울어진다.
		        T = {
		            name = "잔영의 시",
		            skillClass = "short_channel",
		            targetIntent = "many",
		            -- 발수를 50 -> 84로 늘리고 간격을 0.2 -> 0.12로 좁혀 화살이 더 촘촘하게 나가게 했다.
		            -- 지속시간(약 10초)과 총 피해량(2100)은 그대로 유지했다.
		            projectileCount = 84,
		            hitCount = 84,
		            burstCount = 0,
		            tickCount = 84,
		            shape = "front",
		            length = 8.8,
		            width = 1.15,
		            telegraphShape = "front",
		            telegraphLength = 8.8,
		            telegraphWidth = 1.15,
		            hitShape = "front",
		            hitLength = 8.8,
		            hitWidth = 1.15,
		            visualVsHitDelta = 0,
		            damage = 25,
		            cooldown = 115,
		            projectile = true,
		            tickInterval = 0.12,
		            castWindup = 0.12,
		            projectileFireDelay = 0.03,
		            projectileSpeed = 16.2,
		            projectileStartForwardOffset = 0.72,
		            projectileVerticalOffset = 0.3,
		            castMotionDuration = 0.5,
		            useCurrentFacing = true,
		            followCasterDuringChannel = true,
		            followCasterAimDuringChannel = true,
		            maxTargets = 1,
		            maxImpactFxCount = 1,
		            -- T도 이제 R처럼 현재 바라보는 직선 방향으로만 연사한다.
		            telegraph = false,
		            telegraphTime = 0.12,
		            -- effectBaseLength/Width = 이펙트를 스케일 1.0으로 띄웠을 때 화면에서 보이는 칸 수.
		            -- 지금 값은 기존 판정에서 역산한 것이라 동작은 그대로다. Maker에서 이펙트를 보고
		            -- 이 두 숫자만 실제 크기로 고치면, 이후로는 effectScaleMultiplier만 만져도 판정이 따라온다.
		            effectBaseLength = 5.238,
		            effectBaseWidth = 0.685,
		            effectScaleMultiplier = 0.84,
		            projectileScaleMultiplier = 0.92,
		            impactScaleMultiplier = 0.92,
		        },
		    }
	end

	method table BuildVfx()
		    return {
		        -- effect: 시전 순간 이펙트
		        -- effect0/ball: 실제로 날아가는 화살
		        -- impact/effect2: 피격 또는 마지막 폭발
		        -- telegraph: 플레이어가 보는 범위 안내
		        Q = {
		            effect = "2ed6be9152eb4bf0b22f4ca6e6fff9fe",
		            effect0 = "64f775829e234918bd65e9d22214bb06",
		            ball = "64f775829e234918bd65e9d22214bb06",
		            impact = "84a473e004a34fdea67aa74a87dc75c6",
		            sound = "def438f86be84c119eb9dd526254f19c",
		            impactSound = "0bf245911d69455097d7e24a162909f4",
		            playCastEffectOnInput = true,
		        },
		        -- W는 시전 모션, 비행 탄체, 피격 폭발 이펙트를 명확히 분리한다.
		        W = {
		            effect = "01f39ee5971246ed8306bc471d44a1fd",
		            effect0 = "6294c62288bd46beb2ff548bd8671ee0",
		            ball = "6294c62288bd46beb2ff548bd8671ee0",
		            impact = "fe220232a6a945339fb26a5009e555f2",
		            playCastEffectOnInput = true,
		        },
		        -- E는 시전 이펙트만 방향 따라 회전하고, 별도 투사체 없이 범위가 즉시 적용된다.
		        E = {
		            effect = "b187e24d9c0d42abbfa172a13e34059d",
		            impact = "77222253430e496aa51b57ab307805af",
		            sound = "1f616220d57b46f1bc84e176117ebcb4",
		            impactSound = "0dd2fd3c85a5404885514af62608a70b",
		            playCastEffectOnInput = true,
		        },
		        -- R은 버스트 화살 난사. 실제로는 여러 얇은 화살이 전방으로 뻗는다.
		        R = {
		            effect = "9ecf53652b4a437da81417bcd8fb58ca",
		            effect0 = "a342d48c6f03440abdfe46fc5a39fa8a",
		            ball = "a342d48c6f03440abdfe46fc5a39fa8a",
		            impact = "b1bacc61ce0548a89bee3f712c46240d",
		            tickEffect = "5b382e3dd14b430480b729cc3cb56c82",
		            visualTickCount = 25,
		            visualTickInterval = 0.2,
		            tickEffectDelay = 0.12,
		            followCasterDuringChannel = true,
		            effect2 = "8ceb24c27d3147e9a174bac20262358c",
		            endEffectDelay = 5.0,
		            sound = "1e1277a1cbce48a3aeb5297b9ca95b01",
		            impactSound = "00ebddf8e7bb4b5c8a620afc4a9787a0",
		            playCastEffectOnInput = true,
		        },
		        -- T는 시전 -> 유지 모션 반복 -> 투사체 연사 -> 종료 모션 순으로 재생된다.
		        T = {
		            effect = "734670c1a7b046558bb8509ed4e3dec6",
		            tickEffect = "30d2fab7b7104354bd47f2e1cf940c2e",
		            visualTickCount = 84,
		            visualTickInterval = 0.12,
		            tickEffectDelay = 0.12,
		            followCasterDuringChannel = true,
		            effect0 = "d102da7303a94e89aa842696211d8285",
		            ball = "d102da7303a94e89aa842696211d8285",
		            impact = "ae5c25ef58eb44f1b2c8ce497c7d96b8",
		            effect2 = "8303e16fa5834e0eaed0b20a6c458b99",
		            endEffectDelay = 10.0,
		            playCastEffectOnInput = true,
		        },
		    }
	end

end