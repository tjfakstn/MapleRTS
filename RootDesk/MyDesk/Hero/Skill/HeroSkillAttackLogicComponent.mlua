		        ["dd9bf3160b4144638d9d4975d279d9e9"] = { -3.140, -0.620, 1.530, 1.980 },
		        ["96a61fe31122477a8c18685790bb6cde"] = { -3.970, -0.540, 1.250, 2.260 },
		        ["d5dbef88bdc64bf79707a2bcc2364b00"] = { -5.190, -0.090, 3.790, 2.040 },
		        ["1f3d0bf6f7974c7aaa4de29901ee9230"] = { -3.910, -1.650, 0.250, 2.270 },
		        ["0bac49137b31475ab68b9a2cda3814b8"] = { -6.100, -0.510, 1.840, 1.460 },
		        ["9bcd86de860347a2aa4de0ea4b81bd4d"] = { -5.550, -0.310, 1.740, 1.210 },
		        ["81415e9bb5724e419b4009033ff831a8"] = { -3.120, -0.780, 1.620, 1.410 },
		        ["4ba60c46db434a5daee5f264444b6d1b"] = { -7.360, -1.070, 1.270, 4.130 },
		        ["8926218a166542af90eb90910e134c8b"] = { -2.810, -0.540, 2.210, 1.740 },
		        ["6a8ec0369d7143ec8df9261f78e1c01c"] = { -3.010, -0.640, 1.340, 3.140 },
		        }
		    end
		    if ruid == nil or ruid == "" then return nil end
		    if self._T.measuredBounds[ruid] == nil then
		        local kind = _ResourceService:GetTypeAndWait(ruid)
		        if kind == ResourceType.Sprite then
		            local sprite = _ResourceService:LoadSpriteAndWait(ruid)
		            if sprite == nil then return nil end
		            local ppu = math.max(1, sprite.PixelPerUnit)
		            self._T.measuredBounds[ruid] = { -sprite.PivotPixel.x / ppu, -sprite.PivotPixel.y / ppu,
		                (sprite.Width - sprite.PivotPixel.x) / ppu, (sprite.Height - sprite.PivotPixel.y) / ppu }
		            return self._T.measuredBounds[ruid]
		        end
		        if kind ~= ResourceType.AnimationClip then return nil end
		        local clip = _ResourceService:LoadAnimationClipAndWait(ruid)
		        if clip == nil then return nil end
		        local bounds = { math.huge, math.huge, -math.huge, -math.huge }
		        for _, frame in ipairs(clip.Frames:ToTable()) do
		            local sprite = frame.FrameSprite
		            if sprite ~= nil and sprite.Width > 1 and sprite.Height > 1 then
		                local ppu = math.max(1, sprite.PixelPerUnit)
		                bounds[1] = math.min(bounds[1], -sprite.PivotPixel.x / ppu + frame.Offset.x)
		                bounds[2] = math.min(bounds[2], -sprite.PivotPixel.y / ppu + frame.Offset.y)
		                bounds[3] = math.max(bounds[3], (sprite.Width - sprite.PivotPixel.x) / ppu + frame.Offset.x)
		                bounds[4] = math.max(bounds[4], (sprite.Height - sprite.PivotPixel.y) / ppu + frame.Offset.y)
		            end
		        end
		        if bounds[1] == math.huge then return nil end
		        self._T.measuredBounds[ruid] = bounds
		    end
		    return self._T.measuredBounds[ruid]
	end

	method any BuildMeasuredPathBox(string ruid, Vector2 position, Vector2 direction, number scaleX, number scaleY, number angle)
		    local bounds = self:GetMeasuredEffectBounds(ruid)
		    if bounds == nil then return nil end
		    local sign = direction.x >= 0 and -1 or 1
		    local x = (bounds[1] + bounds[3]) * 0.5 * scaleX * sign
		    local y = (bounds[2] + bounds[4]) * 0.5 * scaleY
		    local center = position + Vector2(x * math.cos(angle) - y * math.sin(angle), x * math.sin(angle) + y * math.cos(angle))
		    return BoxShape(center, Vector2((bounds[3] - bounds[1]) * scaleX, (bounds[4] - bounds[2]) * scaleY), angle)
	end

	method any BuildMeasuredEffectBox(string ruid, Vector2 position, Vector2 direction, number scale)
		    local bounds = self:GetMeasuredEffectBounds(ruid)
		    if bounds == nil then return nil end
		    local sign = direction.x >= 0 and -1 or 1
		    local center = position + Vector2((bounds[1] + bounds[3]) * 0.5 * scale * sign, (bounds[2] + bounds[4]) * 0.5 * scale)
		    return BoxShape(center, Vector2((bounds[3] - bounds[1]) * scale, (bounds[4] - bounds[2]) * scale), 0)
	end

	method void BeginAttackTargetFilter(string attackInfo, integer maxTargets)
		    -- 한 번의 Attack() 호출에서 허용할 최대 피격 수를 추적한다.
		    if maxTargets == nil or maxTargets <= 0 then maxTargets = 2147483647 end
		    if self._T.attackTargetFilters == nil then
		        self._T.attackTargetFilters = {}
		    end
		    self._T.attackTargetFilters[attackInfo] = {
		        maxTargets = maxTargets,
		        acceptedCount = 0,
		        acceptedIds = {},
		    }
	end

	method void EndAttackTargetFilter(string attackInfo)
		    -- Attack() 직후 필터 상태를 제거해 다음 스킬 판정과 섞이지 않게 한다.
		    if self._T.attackTargetFilters == nil then return end
		    self._T.attackTargetFilters[attackInfo] = nil
	end

	method boolean AcceptAttackTarget(Entity defender, string attackInfo)
		    -- Core의 부모 검사 이후 진영과 승인 대상 수를 기존 순서로 검사한다.
		    -- 진영 판정은 CombatTeamLogic 한 곳에서만 한다. 예전에는 PlayerComponent.UserId를 직접 비교해서
		    -- 플레이어끼리만 아군 판정이 됐고, PlayerComponent가 없는 RTS 유닛은 아군이어도 다 맞았다.
		    if not isvalid(defender) then
		        return false
		    end
		    if defender == self.Entity then
		        return false
		    end
		    if not _CombatTeamLogic:IsEnemy(self.Entity, defender) then
		        return false
		    end
		    if self._T.attackTargetFilters == nil then
		        return true
		    end
		
		    local filterState = self._T.attackTargetFilters[attackInfo]
		    if filterState == nil or filterState.maxTargets == nil or filterState.maxTargets <= 0 then
		        return true
		    end
		
		    local defenderId = tostring(defender.Id)
		    if filterState.acceptedIds[defenderId] == true then
		        return false
		    end
		    if filterState.acceptedCount >= filterState.maxTargets then
		        return false
		    end
		
		    filterState.acceptedIds[defenderId] = true
		    filterState.acceptedCount = filterState.acceptedCount + 1
		    return true
	end

	method any BuildFrontBox(Vector2 casterPos, Vector2 aimDir, number length, number width)
		    -- 캐스터에서 aimDir 방향으로 뻗는 박스 모양(전방 부채꼴/직선 판정의 근사).
		    local center = casterPos + aimDir * (length / 2)
		    local angle = math.atan(aimDir.y, aimDir.x)
		    return BoxShape(center, Vector2(length, width), angle)
	end

	method any BuildCenteredBox(Vector2 centerPos, Vector2 aimDir, number length, number width)
		    -- 조준 지점 중심의 직사각형 판정. 설치형/지정 장판이 클릭 위치를 기준으로 보이게 할 때 사용한다.
		    local angle = math.atan(aimDir.y, aimDir.x)
		    return BoxShape(centerPos, Vector2(length, width), angle)
	end

	method number ResolveEffectScaleMultiplier(table skill)
		    -- 스킬 데이터의 연출 배율을 판정 계산에 동일하게 사용한다.
		    local scaleMultiplier = tonumber(skill.effectScaleMultiplier or 1) or 1
		    if scaleMultiplier <= 0 then
		        return 1
		    end
		    return scaleMultiplier
	end

	method number ResolveEffectBaseLength(table skill, number rangeScale)
		    -- effectBaseLength는 "이 이펙트를 스케일 1.0으로 띄웠을 때 화면에서 가로 몇 칸으로 보이는가"다.
		    -- Maker에서 눈으로 재서 그대로 적으면 된다. 내부 판정 단위는 rangeScale을 곱하기 전 값이라
		    -- 여기서 되돌려 준다(호출부에서 다시 rangeScale을 곱하므로 상쇄된다).
		    if skill.effectBaseLength ~= nil then
		        return (tonumber(skill.effectBaseLength) or 1) / rangeScale
		    end
		    -- 아직 안 적어둔 스킬은 현재 값에서 역산해서 기존 판정을 그대로 유지한다(회귀 없음).
		    local currentLength = skill.hitLength or skill.hitRadius or skill.length or 1
		    local telegraphLength = skill.telegraphLength or skill.telegraphRadius or currentLength
		    return math.max(currentLength, telegraphLength) / self:ResolveEffectScaleMultiplier(skill)
	end

	method number ResolveEffectBaseWidth(table skill, number rangeScale)
		    -- Core에서 전달한 단위 배율로 기존 판정 너비를 계산한다.
		    if skill.effectBaseWidth ~= nil then
		        return (tonumber(skill.effectBaseWidth) or 1) / rangeScale
		    end
		    if skill.effectBaseLength ~= nil then
		        -- 길이만 지정한 스킬은 원형/정사각 판정으로 본다.
		        return (tonumber(skill.effectBaseLength) or 1) / rangeScale
		    end
		    local currentLength = skill.hitLength or skill.hitRadius or skill.length or 1
		    local currentWidth = skill.hitWidth or skill.hitRadius or skill.width or currentLength
		    local telegraphWidth = skill.telegraphWidth or skill.telegraphRadius or currentWidth
		    return math.max(currentWidth, telegraphWidth) / self:ResolveEffectScaleMultiplier(skill)
	end

	method table ResolveHitboxDimensions(table skill, number rangeScale, number minimumEffectHitPadding)
		    -- ★ 판정 크기는 "보이는 이펙트 크기"에서 유도한다.
		    --      판정(칸) = effectBaseLength × effectScaleMultiplier (+ 스킬별 보정 visualVsHitDelta)
		    -- 예전에는 판정(length/width)과 이펙트(effectScaleMultiplier)가 서로를 전혀 모르는
		    -- 별개 숫자였다. 그래서 이펙트를 키워도 판정은 그대로였고, 그 어긋남을 메우려고
		    -- minimumEffectHitPadding 0.2칸을 전 스킬에 눈대중으로 더하고 있었다.
		    -- 이제 effectScaleMultiplier 하나만 바꾸면 판정이 같이 따라온다.
		    local hitShape = skill.hitShape or skill.shape
		    local scaleMultiplier = self:ResolveEffectScaleMultiplier(skill)
		    local baseLength = self:ResolveEffectBaseLength(skill, rangeScale)
		    local baseWidth = self:ResolveEffectBaseWidth(skill, rangeScale)
		    local extraPadding = (skill.visualVsHitDelta or 0) + (skill.minimumEffectHitPadding or minimumEffectHitPadding)
		
		    local resolvedLength = baseLength * scaleMultiplier + extraPadding
		    local resolvedWidth = baseWidth * scaleMultiplier + extraPadding
		    return {
		        shape = hitShape,
		        length = resolvedLength,
		        width = resolvedWidth,
		    }
	end

	method table ResolveImpactHitboxDimensions(table skill, number rangeScale, number minimumEffectHitPadding)
		    -- 투사체가 도착한 지점에서 터지는 판정. 여기도 impactEffectBaseLength를 적어두면
		    -- 폭발 이펙트 크기 기준으로 판정을 잡는다(단위는 effectBaseLength와 같은 "화면 칸").
		    if skill.impactEffectBaseLength ~= nil then
		        local scaleMultiplier = tonumber(skill.impactScaleMultiplier or skill.effectScaleMultiplier or 1) or 1
		        if scaleMultiplier <= 0 then scaleMultiplier = 1 end
		        local impactBaseLength = (tonumber(skill.impactEffectBaseLength) or 1) / rangeScale
		        local impactBaseWidth = (tonumber(skill.impactEffectBaseWidth or skill.impactEffectBaseLength) or 1) / rangeScale
		        local derivedPadding = (skill.impactVisualVsHitDelta or skill.visualVsHitDelta or 0)
		        return {
		            length = impactBaseLength * scaleMultiplier + derivedPadding,
		            width = impactBaseWidth * scaleMultiplier + derivedPadding,
		        }
		    end
		
		    local baseLength = skill.impactHitLength or skill.hitLength or skill.hitRadius or skill.length or 1
		    local baseWidth = skill.impactHitWidth or skill.hitWidth or skill.hitRadius or skill.width or baseLength
		    local visualLength = skill.impactTelegraphLength or skill.impactTelegraphRadius or baseLength
		    local visualWidth = skill.impactTelegraphWidth or skill.impactTelegraphRadius or baseWidth
		    local extraPadding = (skill.impactVisualVsHitDelta or skill.visualVsHitDelta or 0) + (skill.minimumEffectHitPadding or minimumEffectHitPadding)
		
		    return {
		        length = math.max(baseLength, visualLength) + extraPadding,
		        width = math.max(baseWidth, visualWidth) + extraPadding,
		    }
	end

end