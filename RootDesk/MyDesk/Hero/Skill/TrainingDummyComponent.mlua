@Component
script TrainingDummyComponent extends HitComponent

	property string idleSpriteRuid = "cce899395b8e4174868daa5955730f31"

	property string hitSpriteRuid = "8c0a70a78834426782f79d4a008278c2"

	property string hitSoundRuid = "1bd547c0492c4c99964b3f7441bc0fa4"

	property number hitMotionDuration = 0.42

	property number hitColliderWidth = 1.0

	property number hitColliderHeight = 1.0

	property number hitColliderOffsetY = 0

	@Sync
	property integer receivedHitCount = 0

	@Sync
	property integer receivedDamage = 0

	@Sync
	property string lastHitFeedback = ""

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		    -- 큰 박스 콜라이더로 직선/원형/부채꼴 판정을 반복 확인한다. HP/사망 파이프라인을 사용하지 않으므로 파괴되지 않는다.
		    -- ColliderType/ColliderOffset은 IsLegacy=false에서만 유효하다(msw-combat-system §1-4).
		    self.ColliderType = ColliderType.Box
		    self.BoxSize = Vector2(self.hitColliderWidth, self.hitColliderHeight)
		    self.ColliderOffset = Vector2(0, self.hitColliderOffsetY)
		    self.CollisionGroup = CollisionGroups.HitBox
		
		    _CombatTeamLogic:RegisterEntity(self.Entity, "")
	end

	@ExecSpace("ServerOnly")
	method void OnEndPlay()
		    _CombatTeamLogic:UnregisterEntity(self.Entity)
	end

	method void OnHit(Entity attacker, integer damage, boolean isCritical, string attackInfo, int32 hitCount)
		    -- ★ super 호출이 HitEvent를 발생시킨다. 이 줄을 지우면 아래 HandleHitEvent가 절대 안 돈다.
		    __base:OnHit(attacker, damage, isCritical, attackInfo, hitCount)
	end

	@ExecSpace("ClientOnly")
	method void OnSyncProperty(string name, any value)
		    -- 실제 피격 sync가 들어왔을 때만 허수아비가 눈에 띄게 반응하도록 한다.
		    if name ~= "lastHitFeedback" then return end
		    self:PlayHitFeedback(tostring(value))
	end

	@ExecSpace("ClientOnly")
	method void PlayHitFeedback(string payload)
		    -- 데미지 숫자와 별개로 허수아비 자체를 짧게 튀기고 키워서 "맞았다"는 감각을 바로 준다.
		    local hitIndexStr, damageStr, criticalStr = string.match(payload, "^(%d+):(-?%d+):(%d+):")
		    if hitIndexStr == nil then
		        return
		    end
		
		    local transform = self.Entity.TransformComponent
		    if transform == nil then
		        return
		    end
		
		    local renderer = self.Entity.SpriteRendererComponent
		    if self._T.basePosition == nil then
		        self._T.basePosition = Vector3(transform.Position.x, transform.Position.y, transform.Position.z)
		    end
		    if self._T.hitFeedbackToken == nil then
		        self._T.hitFeedbackToken = 0
		    end
		
		    self._T.hitFeedbackToken = self._T.hitFeedbackToken + 1
		    local currentToken = self._T.hitFeedbackToken
		
		    transform.Position = Vector3(self._T.basePosition.x, self._T.basePosition.y, self._T.basePosition.z)
		    transform.Scale = Vector3(1, 1, 1)
		
		    -- 두 번째 RUID 자체를 실제 피격 모션으로 보여주기 위해, 피격 순간에는 해당 리소스로 확실히 전환한다.
		    if renderer ~= nil then
		        renderer.SpriteRUID = self.hitSpriteRuid
		        renderer.PlayRate = 1
		    else
		    end
		    if self.hitSoundRuid ~= nil and self.hitSoundRuid ~= "" then
		        _SoundService:PlaySound(self.hitSoundRuid, 1)
		    end
		
		    local punchScale = tonumber(criticalStr) == 1 and 1.22 or 1.14
		    local hopHeight = tonumber(criticalStr) == 1 and 0.13 or 0.09
		    _TweenLogic:ScaleTo(self.Entity, Vector2(punchScale, punchScale), 0.05, EaseType.BackEaseOut)
		    _TweenLogic:MoveOffset(self.Entity, Vector2(0, hopHeight), 0.05, EaseType.QuadEaseOut)
		
		    _TimerService:SetTimerOnce(function()
		        if not isvalid(self.Entity) then return end
		        if self._T.hitFeedbackToken ~= currentToken then return end
		
		        self.Entity.TransformComponent.Position = Vector3(self._T.basePosition.x, self._T.basePosition.y, self._T.basePosition.z)
		        if self.Entity.SpriteRendererComponent ~= nil then
		            self.Entity.SpriteRendererComponent.SpriteRUID = self.idleSpriteRuid
		            self.Entity.SpriteRendererComponent.PlayRate = 1
		        end
		        _TweenLogic:ScaleTo(self.Entity, Vector2(1, 1), 0.12, EaseType.QuadEaseOut)
		    end, self.hitMotionDuration)
		
	end

	@EventSender("Self")
	handler HandleHitEvent(HitEvent event)
		    -- 누적 피격 수치와 함께 클라이언트 피드백 트리거를 갱신한다.
		    -- 상태 변경은 서버에서만. 클라이언트는 @Sync -> OnSyncProperty 경로로 연출만 받는다.
		    if not self:IsServer() then
		        return
		    end
		
		    local damage = event.TotalDamage or 0
		    if damage <= 0 then
		    end
		
		    self.receivedHitCount = self.receivedHitCount + 1
		    self.receivedDamage = self.receivedDamage + damage
		    self.lastHitFeedback = tostring(self.receivedHitCount)
		        .. ":" .. tostring(damage)
		        .. ":" .. tostring(event.IsCritical and 1 or 0)
		        .. ":" .. tostring(_UtilLogic.ElapsedSeconds)
		
		    local attackerName = "unknown"
		    if isvalid(event.AttackerEntity) then attackerName = tostring(event.AttackerEntity.Name) end
	end

end