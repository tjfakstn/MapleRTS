@Component
script SpawnUnit extends Component

	property string DefaultCamp = "Adv"

	property number CancelRefundRate = 0.7

	property boolean EnforcePopulation = true

	property number BuildReachDistance = 1.0

	@ExecSpace("Server")
	method void RequestSpawnUnit(string UnitModelID, Entity building)
		-- 클라이언트의 스폰 요청을 받아, 해당 유닛의 생산 시간(초) 이후 건물 주변에 스폰을 예약한다.
		-- 서버 권위: 요청자 본인인지, 요청자 소유의 완공된 건물인지, 그 건물의 생산 슬롯에 있는 유닛인지,
		-- 선행 건물/인구/재화가 충족되는지를 모두 서버에서 확인한 뒤에만 생산을 시작한다.
		local UserId = self.Entity.PlayerComponent.UserId
		if senderUserId ~= UserId then
			log_warning("[SpawnUnit] 생산 거부: 요청자(" .. tostring(senderUserId) .. ")가 이 플레이어가 아님")
			return
		end
		
		--진영 유닛 데이터가 아직 없으면(진영은 골랐는데 로드 전) 한 번 로드한다--
		local pinfo = self.Entity.PlayerInfo
		if next(pinfo.MyUnitData) == nil then
			pinfo:SetUnitData()
		end
		
		local Unitdata = pinfo.MyUnitData[UnitModelID]
		if Unitdata == nil then
			log_warning("[SpawnUnit] 유닛 데이터 없음: " .. tostring(UnitModelID))
			return
		end
		
		--요청자 소유의 건물에서만 생산할 수 있다(건물 없는 요청, 남의 건물 요청은 거부)--
		if not isvalid(building) then
			log_warning("[SpawnUnit] 생산 거부: 생산 건물이 없음")
			return
		end
		---@type Structure_Info
		local binfo = building:GetComponent("script.Structure_Info")
		if binfo == nil or binfo.PlayerID ~= UserId then
			log_warning("[SpawnUnit] 생산 거부: 요청자 소유의 건물이 아님")
			return
		end
		--건설 중이거나 파괴된 건물에서는 생산할 수 없다(UI에서 버튼이 안 뜨지만 서버에서도 막는다)--
		if binfo.IsUnderConstruction or binfo.IsDestroyed then
			_UIToast_:ShowMessage("건설이 끝난 뒤에 사용할 수 있습니다", senderUserId)
			return
		end
		--이 건물의 생산 슬롯에 있는 유닛만 생산할 수 있다(슬롯에 없는 모델이면 cond == nil)--
		---@type StructureAction
		local sact = building:GetComponent("script.StructureAction")
		local cond = nil
		if sact ~= nil then cond = sact:GetConditionForModel(UnitModelID) end
		if cond == nil then
			log_warning("[SpawnUnit] 생산 거부: 이 건물의 생산 슬롯에 없는 유닛 " .. tostring(UnitModelID))
			return
		end
		--선행 건물 조건: 커맨드카드가 잠금으로 보여 주지만, 조작된 요청이나 완공 직전 타이밍을 위해 서버에서 한 번 더 막는다--
		if not _BuildRequirementLogic:HasAliveStructure(building.CurrentMap, UserId, cond) then
			_UIToast_:ShowMessage(_BuildRequirementLogic:GetRequirementText(cond) .. " 필요", senderUserId)
			log_warning("[SpawnUnit] 생산 거부: 선행 건물 없음 (" .. tostring(cond) .. ")")
			return
		end
		
		--인구 상한: 지금 인구 + 생산 중인 인구 + 이번 생산 인구가 상한을 넘으면 거부한다--
		local needPop = self:GetProductionPopulation(Unitdata)
		if self.EnforcePopulation and needPop > 0 then
			local pop = self:GetPopulation(UserId, building.CurrentMap)
			local pending = self._T.pendingPop or 0
			if pop.current + pending + needPop > pop.maximum then
				_UIToast_:ShowMessage("인구가 부족합니다 (" .. tostring(pop.current + pending) .. " / " .. tostring(pop.maximum) .. ")", senderUserId)
				log_warning("[SpawnUnit] 생산 거부: 인구 부족 " .. tostring(pop.current) .. "+" .. tostring(pending) .. "+" .. tostring(needPop) .. " > " .. tostring(pop.maximum))
				return
			end
		end
		
		--생산 비용(메소/에르다) 확인: 부족하면 요청자에게만 안내 토스트를 띄우고 생산을 취소한다.
		--(차감은 큐 슬롯을 실제로 확보한 뒤에 한다 — 아래 slot 확보 참고)--
		local costMeso = Unitdata["메소"] or 0
		local costErda = Unitdata["에르다"] or 0
		if not pinfo:CanAfford(costMeso, costErda) then
			_UIToast_:ShowMessage(pinfo:ShortageMessage(costMeso, costErda), senderUserId)
			return
		end
		
		--건물 주변에 스폰하기 위한 기준 좌표--
		local base = building.TransformComponent.WorldPosition
		
		--생산 시간(초) 만큼 대기 후 실제 스폰. 값이 없으면 즉시 스폰--
		--(SetCampManager_Logic.ParseUnitTable가 CSV의 'time'/'생산(초)' 열을 항상 '생산(초)' 키로 통일해 반환한다)--
		local buildTime = tonumber(Unitdata["생산(초)"]) or 0
		local ruid = Unitdata["Ruid"] or ""
		
		--건물마다 "동시에" 생산 가능한 유닛 수를 4개(슬롯)로 제한한다.
		--StructureProductionQueue가 없는 건물은 제한 없이 기존처럼 동작한다.
		local slot = 0
		---@type StructureProductionQueue
		local queue = building:GetComponent("script.StructureProductionQueue")
		if queue ~= nil then
			slot = queue:TryStart(ruid, buildTime)
			if slot == 0 then
				-- 큐가 가득 참(4개) → 생성을 취소하고 요청한 클라이언트에게만 안내 토스트를 띄운다.
				_UIToast_:ShowMessage("생성 가능한 유닛 수가 가득 찼습니다 (최대 4개)", senderUserId)
				return
			end
		end
		
		--생산이 확정됐으니(큐 슬롯 확보 완료) 비용을 차감하고, 생산 중 인구를 잡아 둔다--
		pinfo:TrySpend(costMeso, costErda)
		self._T.pendingPop = (self._T.pendingPop or 0) + needPop
		log("[SpawnUnit] 생산 시작: " .. tostring(UnitModelID) .. " (" .. tostring(buildTime) .. "초, 인구 +" .. tostring(needPop) .. ")")
		
		local gameSerial = _LobbyController.GameSerial
		_TimerService:SetTimerOnce(function()
			if not isvalid(self.Entity) then return end
			--그 사이 경기가 끝났으면(로비 복귀) 이전 경기의 생산 예약은 스폰/환불 없이 버린다--
			if gameSerial ~= _LobbyController.GameSerial then
				self._T.pendingPop = 0
				return
			end
			self._T.pendingPop = math.max(0, (self._T.pendingPop or 0) - needPop)
			--생산 도중 건물이 파괴/취소됐으면 유닛을 만들지 않고 생산비를 전액 돌려준다--
			if not self:IsProducerAlive(building) then
				self.Entity.PlayerInfo:Refund(costMeso, costErda, 1)
				log_warning("[SpawnUnit] 생산 중단(건물 파괴/취소) → 전액 환불: " .. tostring(UnitModelID))
				return
			end
			self:SpawnUnitNow(UnitModelID, UserId, base, building, slot)
		end, buildTime)
	end

	@ExecSpace("ServerOnly")
	method boolean IsProducerAlive(Entity building)
		-- 생산 건물이 아직 살아 있는지(엔티티 유효 + 파괴되지 않음).
		if not isvalid(building) then return false end
		---@type Structure_Info
		local binfo = building:GetComponent("script.Structure_Info")
		return binfo ~= nil and not binfo.IsDestroyed
	end

	@ExecSpace("ServerOnly")
	method number GetProductionPopulation(table Unitdata)
		-- 생산 1회가 차지하는 인구. MeleeSwarm(초록버섯 등)은 1회에 AbilityValue마리가 나오므로 마리 수를 곱한다.
		local pop = tonumber(Unitdata["인구"]) or 0
		if Unitdata["RoleKey"] == "MeleeSwarm" then
			local count = math.floor(tonumber(Unitdata["AbilityValue"]) or 1)
			if count > 1 then pop = pop * count end
		end
		return pop
	end

	@ExecSpace("ServerOnly")
	method table GetPopulation(string userId, Entity map)
		-- 서버 기준 인구 { current, maximum }. 계산식은 PopulationHUD(클라이언트 표시)와 같다:
		--  · current = MyUnits 안의 살아있는 내 유닛들의 '인구' 합
		--  · maximum = 내 완공된(건설 중 아님) 살아있는 건물들의 PopulationProvide 합
		local result = { current = 0, maximum = 0 }
		if not isvalid(map) then return result end
		local unitData = self.Entity.PlayerInfo.MyUnitData
		
		local group = map:GetChildByName("MyUnits")
		if isvalid(group) then
			for _, child in ipairs(group.Children:ToTable()) do
				---@type Unit_Info
				local info = child:GetComponent("script.Unit_Info")
				-- 영웅은 1인 1기 고정이라 인구를 차지하지 않는다(인구 0).
				if info ~= nil and not info.IsDead and info.PlayerID == userId and child:GetComponent("script.HeroUnit") == nil then
					local row = unitData[info.UnitModelKey]
					if row ~= nil and row["인구"] ~= nil then
						result.current = result.current + row["인구"]
					end
				end
			end
		end
		
		local structures = map:GetChildComponentsByTypeName("script.Structure_Info", true)
		if structures ~= nil then
			for _, s in ipairs(structures) do
				---@type Structure_Info
				local si = s
				-- 건설이 끝난 건물만 인구를 제공한다(PopulationHUD.Refresh와 같은 기준). 파괴된 건물은 제외.
				if si.PlayerID == userId and not si.IsDestroyed and not si.IsUnderConstruction then
					result.maximum = result.maximum + si.PopulationProvide
				end
			end
		end
		return result
	end

	@ExecSpace("ServerOnly")
	method void SpawnUnitNow(string UnitModelID, string OwnerUserId, Vector3 base, Entity building, integer slot)
		-- 대기 시간이 끝난 뒤 실제로 유닛을 스폰한다. 건물이 그동안 파괴되지 않았다면 최신 위치를 다시 읽는다.
		if isvalid(building) then
			base = building.TransformComponent.WorldPosition
		end
		
		--생산 완료 → 이 건물의 생산 큐에서 해당 슬롯을 비운다(다음 요청이 이 슬롯을 다시 쓸 수 있게 됨)--
		if isvalid(building) and slot > 0 then
			---@type StructureProductionQueue
			local queue = building:GetComponent("script.StructureProductionQueue")
			if queue ~= nil then queue:ClearSlot(slot) end
		end
		
		--스폰된 유닛을 MyUnits 그룹의 자식으로 넣어 드래그 선택 대상이 되게 한다--
		local parent = self.Entity.CurrentMap:GetChildByName("MyUnits")
		if not isvalid(parent) then
			parent = self.Entity.CurrentMap
		end
		
		--같은 지점에 겹쳐 스폰되지 않도록 흩뿌림--
		--UnitMoveComponent.SeparationRadius(기본 0.7)보다 확실히 넓게 흩어야
		--스폰 직후 겹침 방지 로직이 즉시 밀어내며 "명령 없이 움직이는" 것처럼 보이지 않는다--
		--SpawnByModelId의 pos는 parent 기준 로컬 좌표라서, 건물의 월드 좌표를 parent 기준으로 변환해야 한다.
		--(변환 없이 월드 좌표를 그대로 넘기면 MyUnits의 위치만큼 어긋난 곳에 스폰된다.)
		local parentPos = parent.TransformComponent.WorldPosition
		local jx = (_UtilLogic:RandomDouble() - 0.5) * 2.4
		local jy = (_UtilLogic:RandomDouble() - 0.5) * 2.4
		-- z도 x/y와 마찬가지로 parent 기준 로컬 좌표로 변환해야 한다.
		-- 변환 없이 건물의 월드 z(예: 999.998)를 그대로 넘기면, parent(MyUnits) 자신도
		-- 월드 z(예: 999.999)를 갖고 있어 최종 월드 z가 두 배(약 1999)로 커져
		-- 카메라 렌더 범위를 벗어나 유닛이 화면에 보이지 않게 된다.
		local SpawnPos = Vector3(base.x + jx - parentPos.x, base.y + jy - parentPos.y, base.z - parentPos.z)
		
		local Unit = _SpawnService:SpawnByModelId(UnitModelID, "Unit", SpawnPos, parent)
		--Spawn한 Unit 정보 + 소유자 UserId를 최신화하기--
		if Unit then
			self:SetUnitdata(Unit, UnitModelID, OwnerUserId)
		
			--건물에 생산 이펙트가 설정돼 있으면(StructureEffectComponent) 스폰 지점에 재생--
			if isvalid(building) then
				---@type StructureEffectComponent
				local fx = building:GetComponent("script.StructureEffectComponent")
				if fx ~= nil then
					-- 이펙트는 건물 중심이 아니라 새로 생긴 유닛의 위치에서, 유닛 스프라이트 아랫단에 맞춰 재생한다.
					local unitPos = Unit.TransformComponent.WorldPosition
					fx:PlaySpawnUnitEffect(unitPos, Unit.SpriteRendererComponent.SpriteRUID, Unit.TransformComponent.Scale.y)
				end
			end
		
			-- MeleeSwarm(초록버섯 등): 생산 1회에 여러 마리를 만든다. AbilityValue = 총 마리 수.
			if Unit.Unit_Info.RoleKey == "MeleeSwarm" then
				local extraCount = math.floor(Unit.Unit_Info.AbilityValue) - 1
				for _ = 1, extraCount do
					local ex = (_UtilLogic:RandomDouble() - 0.5) * 2.4
					local ey = (_UtilLogic:RandomDouble() - 0.5) * 2.4
					local extraPos = Vector3(base.x + ex - parentPos.x, base.y + ey - parentPos.y, base.z - parentPos.z)
					local extraUnit = _SpawnService:SpawnByModelId(UnitModelID, "Unit", extraPos, parent)
					if extraUnit then
						self:SetUnitdata(extraUnit, UnitModelID, OwnerUserId)
					end
				end
			end
		end
	end

	@ExecSpace("Server")
	method void RequestCancelEntity(Entity target)
		-- Action UI의 "취소" 버튼(본진 제외 모든 내 유닛/건물). 원래 비용의 CancelRefundRate배를 환불한다.
		--  · 유닛: 즉시 사망 처리(사망 모션 재생) + 즉시 환불, 사망 모션이 끝날 즈음 엔티티 제거.
		--  · 건물: 파괴 처리(파괴 애니메이션 재생) → 애니메이션 시간이 지난 뒤 환불 + 엔티티 제거.
		if not isvalid(target) then return end
		local pinfo = self.Entity.PlayerInfo
		if pinfo == nil then return end
		
		---@type Unit_Info
		local uinfo = target:GetComponent("script.Unit_Info")
		if uinfo ~= nil then
			if uinfo.PlayerID ~= senderUserId or uinfo.IsDead then
				log_warning("[SpawnUnit] 유닛 취소 거부: 요청자 소유가 아니거나 이미 사망")
				return
			end
		
			uinfo.Hp = 0
			uinfo.IsDead = true
			uinfo:ScheduleCorpseRemoval()
			pinfo:Refund(uinfo.Meso, uinfo.Erda, self.CancelRefundRate)
		
			---@type UnitStateComponent
			local st = target:GetComponent("script.UnitStateComponent")
			local delay = 1.0
			if st ~= nil then delay = st.DestroyDelay end
			_TimerService:SetTimerOnce(function()
				if isvalid(target) then target:Destroy() end
			end, delay)
			log("[SpawnUnit] 유닛 취소: " .. tostring(target.Name))
			return
		end
		
		-- 건물은 취소(파괴/환불) 액션을 제공하지 않는다.
		log_warning("[SpawnUnit] 건물 취소 요청 거부: 건물 취소 기능은 제거됨")
	end

	@ExecSpace("ServerOnly")
	method void SpawnStartingUnit(string UnitModelID, string OwnerUserId, Vector3 worldPos, Entity map)
		-- 게임 시작 시 생산 큐/대기 시간 없이 유닛(시작 일꾼)을 정확한 월드 좌표에 바로 스폰한다.
		-- LobbyController.StartGame이 플레이어를 게임 맵으로 텔레포트한 직후 호출하므로, 이 컴포넌트의
		-- self.Entity.CurrentMap(아직 로비일 수 있음)이 아니라 호출자가 넘겨준 게임 맵(map)을 쓴다.
		local pinfo = self.Entity.PlayerInfo
		if next(pinfo.MyUnitData) == nil then
			pinfo:SetUnitData()
		end
		if pinfo.MyUnitData[UnitModelID] == nil then
			log_warning("[SpawnUnit] 시작 유닛 데이터 없음: " .. tostring(UnitModelID))
			return
		end
		
		local parent = map:GetChildByName("MyUnits")
		if not isvalid(parent) then
			parent = map
		end
		
		-- SpawnByModelId의 pos는 parent 기준 로컬 좌표(SpawnUnitNow와 동일한 이유로 x/y/z 모두 변환).
		local parentPos = parent.TransformComponent.WorldPosition
		local localPos = Vector3(worldPos.x - parentPos.x, worldPos.y - parentPos.y, worldPos.z - parentPos.z)
		
		local Unit = _SpawnService:SpawnByModelId(UnitModelID, "Unit", localPos, parent)
		if Unit then
			self:SetUnitdata(Unit, UnitModelID, OwnerUserId)
			log("[SpawnUnit] 시작 유닛 스폰: " .. tostring(UnitModelID))
		else
			log_warning("[SpawnUnit] 시작 유닛 스폰 실패: " .. tostring(UnitModelID))
		end
	end

	@ExecSpace("Server")
	method void RequestBuildStructure(string ModelId, Vector2 Pos, number BuildTime, Entity worker, string Ruid)
		-- 일꾼이 목표 위치에 도착한 뒤(BuildGhostComponent) 호출되는 건설 요청. 요청자 소유의 일꾼인지 확인한다.
		-- 건물은 이 요청 시점에 "즉시" 스폰한다(건설 중 상태로) — 건설 이펙트는 "건물이 보이는 동안
		-- 그 자리에서" 진행되는 연출이어야 하므로, 건물이 나타나는 시점 자체를 늦추지 않고 대신
		-- StructureEffectComponent가 실제 건설 시간(BuildTime)만큼 건설 애니메이션을 유지한다.
		-- 일꾼의 "건설 중" 표시(WorkerBuildState)도 같은 BuildTime 동안 유지되다가 함께 정리된다.
		local UserId = self.Entity.PlayerComponent.UserId
		if senderUserId ~= UserId then
			log_warning("[SpawnUnit] 건설 요청 거부: 요청자(" .. tostring(senderUserId) .. ")가 이 플레이어가 아님")
			return
		end
		
		if not isvalid(worker) or worker.Unit_Info == nil or worker.Unit_Info.PlayerID ~= UserId or worker.Unit_Info.IsDead then
			log_warning("[SpawnUnit] 건설 요청 거부: 요청자 소유의 살아있는 일꾼이 아님")
			return
		end
		
		-- 건설 시간/건물 크기는 클라이언트가 보낸 값을 믿지 않고, 서버가 건설 목록(일꾼/내 영역 건물 슬롯, Arda 채집 건물은
		-- ArdaBuildLogic)에서 다시 읽는다. 어느 목록에도 없는 모델은 지을 수 없다.
		local buildItem = _BuildRequirementLogic:FindBuildItem(worker.CurrentMap, UserId, worker, ModelId)
		if buildItem == nil and _ArdaBuildLogic:IsArdaStructureModel(ModelId) then
			buildItem = _ArdaBuildLogic:GetBuildData()
		end
		if buildItem == nil then
			log_warning("[SpawnUnit] 건설 요청 거부: 건설 목록에 없는 건물 " .. tostring(ModelId))
			return
		end
		BuildTime = math.max(0, tonumber(buildItem.BuildTime) or 0)
		
		-- 일꾼이 실제로 건설 위치에 도착해 있어야 한다(클라이언트 도착 판정을 서버에서도 확인).
		local workerPos = worker.TransformComponent.WorldPosition
		if Vector2.Distance(Vector2(workerPos.x, workerPos.y), Pos) > self.BuildReachDistance then
			log_warning("[SpawnUnit] 건설 요청 거부: 일꾼이 건설 위치에 없음")
			return
		end
		
		-- 다른 건물과 겹치는 자리에는 지을 수 없다(클라이언트 고스트가 막지만 서버에서도 검증한다).
		if self:IsBlockedByStructure(worker.CurrentMap, Pos, tonumber(buildItem.SizeX) or 1, tonumber(buildItem.SizeY) or 1) then
			_UIToast_:ShowMessage("다른 건물과 겹치는 위치에는 지을 수 없습니다", senderUserId)
			log_warning("[SpawnUnit] 건설 거부: 다른 건물과 겹침 " .. tostring(ModelId))
			return
		end
		
		-- 선행 건물 조건: 클라이언트 카드가 잠금으로 막지만 서버에서도 검증한다(일꾼 슬롯 → 내 영역 건물 슬롯 순으로 조건을 찾음).
		local cond = _BuildRequirementLogic:FindBuildCondition(worker.CurrentMap, UserId, worker, ModelId)
		if cond ~= nil and not _BuildRequirementLogic:HasAliveStructure(worker.CurrentMap, UserId, cond) then
			_UIToast_:ShowMessage(_BuildRequirementLogic:GetRequirementText(cond) .. " 필요", senderUserId)
			log_warning("[SpawnUnit] 건설 거부: 선행 건물 없음 (" .. tostring(cond) .. ")")
			return
		end
		
		-- Arda 채집 건물은 Arda_MonsterSpawner 영역 안에만 지을 수 있다(클라이언트 고스트가 막지만 서버에서도 검증한다).
		if _ArdaBuildLogic:IsArdaStructureModel(ModelId) and not isvalid(_ArdaBuildLogic:FindSpawnerContaining(self.Entity.CurrentMap, Pos)) then
			_UIToast_:ShowMessage("Arda 채집 건물은 Arda 몬스터 스포너 영역 안에만 지을 수 있습니다", senderUserId)
			log_warning("[SpawnUnit] 건설 거부: 스포너 영역 밖의 Arda 채집 건물")
			return
		end
		
		-- 진영/건물 종류에 따라 영역(제공 건물 반경 합집합) 안에서만 건설할 수 있다(BuildZoneLogic.ProvidersFor).
		-- 클라이언트 고스트가 막지만 서버에서도 검증한다. 건물 종류는 진영 데이터셋의 BuildingKey/Name으로 판단한다.
		local zoneCamp = self.Entity.PlayerInfo.SelectedCamp
		local zoneTable = _SetCampManager_Logic:SelectedCampStructure(zoneCamp)
		local zoneRow = (zoneTable ~= nil) and zoneTable[ModelId] or nil
		local zoneProviders = _BuildZoneLogic:ProvidersFor(zoneCamp, zoneRow ~= nil and zoneRow.BuildingKey or "", zoneRow ~= nil and zoneRow.Name or "")
		if zoneProviders ~= "" and not _BuildZoneLogic:IsInZone(self.Entity.CurrentMap, UserId, Pos, zoneProviders) then
			_UIToast_:ShowMessage(_BuildZoneLogic:RestrictMessage(zoneCamp), senderUserId)
			log_warning("[SpawnUnit] 건설 거부: 건설 가능 영역 밖 " .. tostring(ModelId) .. " (providers=" .. zoneProviders .. ")")
			return
		end
		
		-- 이동 불가 타일 위에는 지을 수 없다(클라이언트 고스트가 막지만 서버에서도 검증한다).
		if not _BuildZoneLogic:IsWalkable(self.Entity.CurrentMap, Pos) then
			_UIToast_:ShowMessage("일꾼이 이동할 수 없는 지역에는 지을 수 없습니다", senderUserId)
			log_warning("[SpawnUnit] 건설 거부: 이동 불가 타일 " .. tostring(ModelId))
			return
		end
		
		-- 건설 비용(메소/에르다): 소유자 진영의 Structure_Stat_DataSet에서 조회한다(ApplyStructureData와 동일한 경로).
		-- 부족하면 요청자에게만 안내 토스트를 띄우고 건설을 취소한다(일꾼은 이미 도착해 있으므로 그 자리에 그대로 남는다).
		-- 데이터셋에 등록되지 않은 건물은 비용 0으로 취급한다.
		local pinfo = self.Entity.PlayerInfo
		local costMeso = 0
		local costErda = 0
		local structTable = _SetCampManager_Logic:SelectedCampStructure(pinfo.SelectedCamp)
		if structTable ~= nil and structTable[ModelId] ~= nil then
			costMeso = structTable[ModelId].Meso or 0
			costErda = structTable[ModelId].Arda or 0
		elseif _ArdaBuildLogic:IsArdaStructureModel(ModelId) then
			-- Arda 채집 건물은 진영 데이터셋이 아니라 Arda_Structure_Data_set의 Meso가 건설 비용이다.
			local ardaData = _ArdaBuildLogic:GetData()
			if ardaData ~= nil then costMeso = ardaData.Meso or 0 end
		end
		if not pinfo:TrySpend(costMeso, costErda) then
			_UIToast_:ShowMessage(pinfo:ShortageMessage(costMeso, costErda), senderUserId)
			log_warning("[SpawnUnit] 건설 취소: 재화 부족 " .. tostring(ModelId))
			return
		end
		
		-- 유닛 스폰(SpawnUnitNow)과 동일하게, 같은 평면(z)에 있는 기존 엔티티(일꾼)의 월드 z를 기준으로 삼는다.
		local baseZ = worker.TransformComponent.WorldPosition.z
		
		-- 이 일꾼이 "건설 중"임을 기록해, 건설 중 그 일꾼을 클릭했을 때 정보 UI가 남은 시간을 보여줄 수 있게 한다.
		---@type WorkerBuildState
		local buildState = worker:GetComponent("script.WorkerBuildState")
		if buildState ~= nil then
			-- 시그너스 일꾼은 건설을 시작(건물 스폰)한 뒤에는 건설이 끝나길 기다리지 않고 다른 명령을 바로 수행할 수 있다.
			buildState:StartBuild(Ruid, BuildTime, self.Entity.PlayerInfo.SelectedCamp == "Cyg")
		end
		
		self:BuildStructureNow(ModelId, UserId, Pos, baseZ, BuildTime)
		
		-- 모험가는 건물 데이터셋의 BuildStyle("스포아가 성장하며 소모")대로, 일꾼(스포아)이 건설 위치에 도착해 건물 건설이
		-- 시작되는 순간 소모된다(사망 처리 → 사망 모션 후 제거). 건물 건설은 일꾼과 무관하게 계속 진행된다.
		-- Arda 채집 건물은 진영 건물 데이터셋 대상이 아니라 일꾼을 소모하지 않는다.
		if self.Entity.PlayerInfo.SelectedCamp == "Adv" and not _ArdaBuildLogic:IsArdaStructureModel(ModelId) then
			---@type Unit_Info
			local workerInfo = worker:GetComponent("script.Unit_Info")
			if workerInfo ~= nil and not workerInfo.IsDead then
				workerInfo.Hp = 0
				workerInfo.IsDead = true
				workerInfo:ScheduleCorpseRemoval()
				log("[SpawnUnit] 일꾼 소모(건설 시작): " .. tostring(worker.Name))
			end
		end
		
		_TimerService:SetTimerOnce(function()
			-- 일꾼이 소모되어 사라졌을 수 있다.
			if buildState ~= nil and isvalid(buildState) then
				buildState:ClearBuild()
			end
		end, BuildTime)
	end

	@ExecSpace("Server")
	method void RequestConvertStructure(Entity tree, string ModelId)
		-- 영역 전개(RegionBuildAction.ConvertInPlace) 건물을 목록에서 고른 영역 건물(헤네시스/페리온/엘리니아/커닝시티 영역)로
		-- 변환한다: 요청자 소유의 완공된 건물인지, 고른 건물이 그 건물의 (선행 조건을 만족한) 목록에 있는지 확인하고
		-- 변환 대상 건물의 건설 비용을 결제한 뒤, 같은 자리에 대상 건물을 건설 상태로 새로 지으며 원래 건물은 제거한다.
		local UserId = self.Entity.PlayerComponent.UserId
		if senderUserId ~= UserId then
			log_warning("[SpawnUnit] 변환 거부: 요청자(" .. tostring(senderUserId) .. ")가 이 플레이어가 아님")
			return
		end
		if not isvalid(tree) then return end
		
		---@type Structure_Info
		local info = tree:GetComponent("script.Structure_Info")
		---@type RegionBuildAction
		local region = tree:GetComponent("script.RegionBuildAction")
		if info == nil or region == nil or not region.ConvertInPlace or info.PlayerID ~= UserId or info.IsDestroyed or info.IsUnderConstruction then
			log_warning("[SpawnUnit] 변환 거부: 변환 가능한 내 건물이 아님")
			return
		end
		
		local buildTime = nil
		local lockReason = nil
		for _, item in ipairs(region:GetBuildList()) do
			if item.Model == ModelId then
				-- 목록에는 잠긴(선행 건물 없는) 항목도 들어 있으므로 잠금 여부를 따로 본다.
				if item.Locked then lockReason = item.LockReason or "" else buildTime = item.BuildTime end
			end
		end
		if lockReason ~= nil then
			_UIToast_:ShowMessage(lockReason .. " 필요", senderUserId)
			log_warning("[SpawnUnit] 변환 거부: 선행 건물 없음 " .. tostring(ModelId) .. " (" .. lockReason .. ")")
			return
		end
		if buildTime == nil then
			log_warning("[SpawnUnit] 변환 거부: 목록에 없음 " .. tostring(ModelId))
			return
		end
		
		local pinfo = self.Entity.PlayerInfo
		local structTable = _SetCampManager_Logic:SelectedCampStructure(pinfo.SelectedCamp)
		local row = (structTable ~= nil) and structTable[ModelId] or nil
		local costMeso = (row ~= nil and row.Meso) or 0
		local costErda = (row ~= nil and row.Arda) or 0
		if not pinfo:TrySpend(costMeso, costErda) then
			_UIToast_:ShowMessage(pinfo:ShortageMessage(costMeso, costErda), senderUserId)
			log_warning("[SpawnUnit] 변환 취소: 재화 부족 " .. tostring(ModelId))
			return
		end
		
		local wp = tree.TransformComponent.WorldPosition
		local oldName = info.StructureName
		self:BuildStructureNow(ModelId, UserId, Vector2(wp.x, wp.y), wp.z, buildTime)
		tree:Destroy()
		log("[SpawnUnit] 건물 변환: " .. tostring(oldName) .. " → " .. tostring(ModelId))
	end

	@ExecSpace("ServerOnly")
	method boolean IsBlockedByStructure(Entity map, Vector2 pos, number sizeX, number sizeY)
		-- pos에 sizeX×sizeY 크기의 건물을 놓으면 기존(파괴되지 않은) 건물의 본체 박스(TriggerComponent)와 겹치는지.
		-- 가장자리가 살짝 맞닿는 정도는 허용하도록 0.05만큼 줄여서 비교한다.
		if not isvalid(map) then return false end
		local structures = map:GetChildComponentsByTypeName("script.Structure_Info", true)
		if structures == nil then return false end
		local halfX = math.max(0, sizeX / 2 - 0.05)
		local halfY = math.max(0, sizeY / 2 - 0.05)
		for _, s in ipairs(structures) do
			---@type Structure_Info
			local si = s
			local e = si.Entity
			if isvalid(e) and e.Enable and not si.IsDestroyed and e.TriggerComponent ~= nil and e.TransformComponent ~= nil then
				local trigger = e.TriggerComponent
				local scale = e.TransformComponent.Scale
				local wp = e.TransformComponent.WorldPosition
				local cx = wp.x + trigger.ColliderOffset.x * scale.x
				local cy = wp.y + trigger.ColliderOffset.y * scale.y
				local otherHalfX = math.abs(trigger.BoxSize.x * scale.x) / 2
				local otherHalfY = math.abs(trigger.BoxSize.y * scale.y) / 2
				if math.abs(pos.x - cx) < halfX + otherHalfX and math.abs(pos.y - cy) < halfY + otherHalfY then
					return true
				end
			end
		end
		return false
	end

	@ExecSpace("ServerOnly")
	method void BuildStructureNow(string ModelId, string OwnerUserId, Vector2 Pos, number BaseZ, number BuildTime)
		-- 건물을 즉시 스폰한다. 건물도 유닛처럼 별도 그룹의 자식으로 두어(예: MyStructures) 관리하고,
		-- 없으면 맵 바로 아래에 스폰한다.
		-- "MyStructures" 그룹은 선택 사항이다(맵에 만들어 두면 그 안에, 없으면 맵 루트에 바로 스폰한다).
		-- 맵 루트 엔티티 자체는 TransformComponent가 없을 수 있으므로(실측 확인됨) 그 경우 (0,0,0)을 기준으로 한다.
		local map = self.Entity.CurrentMap
		local parent = map:GetChildByName("MyStructures")
		if not isvalid(parent) or not isvalid(parent.TransformComponent) then
			parent = map
		end
		
		-- x/y/z 모두 parent 기준 로컬 좌표로 변환해야 한다(SpawnUnitNow와 동일한 이유 — 변환 없이
		-- 월드 좌표를 그대로 넘기면 parent의 위치만큼 어긋나거나, z가 겹쳐 더블로 커져 화면에서 사라진다).
		local parentPos = Vector3(0, 0, 0)
		if isvalid(parent.TransformComponent) then
			parentPos = parent.TransformComponent.WorldPosition
		end
		local SpawnPos = Vector3(Pos.x - parentPos.x, Pos.y - parentPos.y, BaseZ - parentPos.z)
		
		local Structure = _SpawnService:SpawnByModelId(ModelId, "Structure", SpawnPos, parent)
		if Structure then
			local info = Structure.Structure_Info
			if info ~= nil then
				info:SetOwner(OwnerUserId)
				info.BuildTime = BuildTime
		
				-- 건설 시간 동안은 건물 기능을 막는다(Structure_Info.IsUnderConstruction). 시간이 끝나면 풀어준다.
				-- 그 사이 건물이 파괴/취소로 사라졌으면 아무것도 하지 않는다.
				if BuildTime > 0 then
					info.ConstructionEndTime = _UtilLogic.ServerElapsedSeconds + BuildTime
					info.IsUnderConstruction = true
					_TimerService:SetTimerOnce(function()
						if isvalid(Structure) and isvalid(Structure.Structure_Info) then
							Structure.Structure_Info.IsUnderConstruction = false
							log("[SpawnUnit] 건설 완료(기능 활성화): " .. tostring(Structure.Name))
						end
					end, BuildTime)
				end
			end
		
			self:ApplyStructureData(Structure, ModelId, OwnerUserId)
		
			-- OnBeginPlay는 각 클라이언트에서 기본 재생 시간으로 이미 한 번 돌았을 수 있으므로,
			-- 서버가 알고 있는 실제 건설 시간(BuildTime)으로 모든 클라이언트에서 다시 맞춰준다.
			---@type StructureEffectComponent
			local fx = Structure:GetComponent("script.StructureEffectComponent")
			if fx ~= nil then fx:StartConstruction(BuildTime) end
		
			log("[SpawnUnit] 건물 건설 시작(" .. tostring(BuildTime) .. "초): " .. tostring(ModelId))
		end
	end

	@ExecSpace("ServerOnly")
	method void ApplyStructureData(Entity Structure, string ModelId, string OwnerUserId)
		-- Arda 채집 건물은 진영 데이터셋에 없고 Arda_Structure_Data_set에서 스탯을 읽는다.
		if _ArdaBuildLogic:IsArdaStructureModel(ModelId) then
			_ArdaBuildLogic:ApplyStructureData(Structure)
			return
		end
		
		-- 건물 스탯(HP/방어/비용/제공 인구/역할/이름)을 소유자 진영의 Structure_Stat_DataSet에서
		-- 조회해 주입한다(SetUnitdata가 유닛에 CSV 값을 채워 넣는 것과 동일한 패턴). 아직 데이터셋에
		-- Model이 등록되지 않은 건물(다른 건물 계열 등)은 조용히 건너뛰고 .model에 이미 박혀 있는
		-- 기본값을 그대로 쓴다.
		local owner = _UserService:GetUserEntityByUserId(OwnerUserId)
		if not isvalid(owner) then return end
		---@type PlayerInfo
		local pinfo = owner:GetComponent("script.PlayerInfo")
		if pinfo == nil or pinfo.SelectedCamp == "" then return end
		
		local table_ = _SetCampManager_Logic:SelectedCampStructure(pinfo.SelectedCamp)
		if table_ == nil then return end
		local data = table_[ModelId]
		if data == nil then
			log_warning("[SpawnUnit] 건물 데이터(Structure_Stat_DataSet)에 없는 모델이라 인구/스탯을 주입하지 못함: " .. tostring(ModelId) .. " (" .. tostring(pinfo.SelectedCamp) .. ")")
			return
		end
		
		local info = Structure.Structure_Info
		if info == nil then return end
		
		if data.HP ~= nil then
			info.Hp = math.floor(data.HP)
			info.MaxHp = math.floor(data.HP)
		end
		if data.defense ~= nil then info.defense = data.defense end
		if data.Meso ~= nil then info.Meso = data.Meso end
		if data.Arda ~= nil then info.Erda = data.Arda end
		if data.Population ~= nil then info.PopulationProvide = math.floor(data.Population) end
		if data.BuildingKey ~= nil then info.BuildingKey = data.BuildingKey end
		if data.Name ~= nil then info.StructureName = data.Name end

		-- 시야(Vision-Spec-20261004.md §2, §5): CSV 'vision' ÷ 50 = 월드 유닛 반지름. 등급표에 없는 건물/열이 없는 데이터셋은
		-- Production 기본값 225(4.5). 본진은 LobbyController.SpawnPlayerHQ가 이 함수를 그대로 쓰므로 자동 적용된다.
		info.Vision = (tonumber(data.vision) or 225) / 50
		-- 탐지기(§4-4, §8): Tech / FinalTech 건물만 시야 반지름 안의 은신 유닛을 드러낸다.
		info.IsDetector = (info.BuildingKey == "Tech" or info.BuildingKey == "FinalTech")
		
		log("[SpawnUnit] 건물 데이터 주입: " .. tostring(data.Name) .. " (HP=" .. tostring(info.Hp) .. ", BuildingKey=" .. tostring(info.BuildingKey) .. ", 제공 인구=" .. tostring(info.PopulationProvide) .. ")")
	end

	@ExecSpace("ServerOnly")
	method void SetUnitdata(Entity Unit, string UnitModelID, string OwnerUserId)
		-- 스폰된 유닛에 스탯과 소유자(PlayerID)를 세팅한다.
		-- 소유자(PlayerID)는 진영 데이터 유무와 무관하게 항상 먼저 세팅해야 드래그 선택에 포함된다.
		Unit.Unit_Info.PlayerID = OwnerUserId
		-- 유닛 종류 키(커맨드카드 단축키 조회용). 진영 데이터가 없어도 종류는 알 수 있게 먼저 세팅한다.
		Unit.Unit_Info.UnitModelKey = UnitModelID
		
		
		local AllUnitData = self.Entity.PlayerInfo.MyUnitData
		local Unitdata = AllUnitData[UnitModelID]
		if Unitdata == nil then
			log_warning("[SpawnUnit] 유닛 데이터 없음: " .. tostring(UnitModelID))
			return
		end
		
		Unit.Unit_Info.Line = Unitdata["Line"]
		Unit.Unit_Info.Meso = tonumber(Unitdata["메소"])
		Unit.Unit_Info.Erda = tonumber(Unitdata["에르다"])
		Unit.Unit_Info.Hp = tonumber(Unitdata["HP"])
		Unit.Unit_Info.MaxHp = tonumber(Unitdata["HP"])
		Unit.Unit_Info.defense = tonumber(Unitdata["defense"])
		Unit.Unit_Info.baseDefense = tonumber(Unitdata["defense"])
		Unit.Unit_Info.damage = tonumber(Unitdata["damage"])
		-- CSV 'Cooltime' 열에는 기획 시트의 공속(초당 공격 횟수)이 들어 있다. Weapon은 AttackCoolTime을 공격 간격(초)으로
		-- 쓰므로 역수(1 / 공속)로 변환해 넣는다. 공속이 0 이하(공격 없는 유닛, 예: 수송선)면 Unit_Info 기본값을 그대로 둔다.
		local attackSpeed = tonumber(Unitdata["Cooltime"]) or 0
		if attackSpeed > 0 then
			Unit.Unit_Info.AttackCoolTime = 1 / attackSpeed
		end
		Unit.Unit_Info.MoveSpeed = tonumber(Unitdata["MoveSpeed"])
		Unit.Unit_Info.TargetRange = tonumber(Unitdata["Target"])
		-- 지상/공중 구분: CSV 'IsAerial' 열(1=공중). SetCampManager_Logic.ParseUnitTable이 이미 boolean으로 변환해 둔다.
		Unit.Unit_Info.IsAerial = Unitdata["IsAerial"] == true
		
		-- 공격 사거리: CSV 'AttackRange' 열. 데이터셋 값(예: 근접 40~55, 원거리 150~300)은 월드 유닛이
		-- 아니라 이 프로젝트가 쓰는 "1 world unit = 100px" 기준의 px 단위이므로 100으로 나눠 실제
		-- 전투 사거리(world unit)로 변환한다(사용자 확인: 그대로 쓰면 유닛 몸통(0.36~0.7유닛) 대비
		-- 근접도 몸집의 100배 가까운 사거리가 되어 근접/원거리 구분이 사라짐). 없으면 0 → Weapon이
		-- 근접 기본값(MeleeRange) 사용.
		local attackRange = Unitdata["AttackRange"]
		Unit.Unit_Info.AttackRange = attackRange ~= nil and (tonumber(attackRange) / 100) or 0
		
		-- 특수능력: CSV 'RoleKey'/'AbilityValue'/'AbilityDuration' 열을 그대로 주입한다.
		-- 실제 발동은 Weapon(피격 시 즉발형) / SpecialAbilityComponent(지속형) 가 RoleKey를 보고 분기한다.
		Unit.Unit_Info.RoleKey = Unitdata["RoleKey"] or ""
		Unit.Unit_Info.AbilityValue = tonumber(Unitdata["AbilityValue"]) or 0
		Unit.Unit_Info.AbilityDuration = tonumber(Unitdata["AbilityDuration"]) or 0

		-- 시야(Vision-Spec-20261004.md §1): CSV 'vision'(200~300)은 사거리(÷100)와 달리 ÷50이 월드 유닛 반지름이다.
		-- 열이 없거나 비어 있으면 기본 225(4.5)를 쓴다.
		Unit.Unit_Info.Vision = (tonumber(Unitdata["vision"]) or 225) / 50
		-- 은신: CSV 'IsStealth' 열(1=은신). RoleKey와 무관하게 이 열만 본다(추적자 레드가 RoleKey=RangedBasic인 이유 — §8-3).
		Unit.Unit_Info.IsStealth = Unitdata["IsStealth"] == true
		-- 탐지기: 소울(model c6660784-...)만 유닛 탐지기다. 스펙 §9-5의 U(시야 공유) 토글은 아직 구현하지 않았으므로
		-- 지금은 "항상 켜진 상태"(시야 6.0 + 탐지)로 취급한다 — 토글 구현 시 여기와 VisionLogic.CollectSources를 함께 고친다.
		-- (UnitModelKey는 "model://<uuid>" 형식이라 uuid 부분 문자열로 비교한다.)
		Unit.Unit_Info.IsDetector = string.find(UnitModelID, "c6660784-8468-4dc7-be04-cb7dcf7ba60b", 1, true) ~= nil
		
		-- MeleeSwarm(초록버섯 등)은 생산 1회 비용으로 AbilityValue마리가 나온다. 마리마다 전체 비용을 적어 두면
		-- 취소 환불 합계가 생산비를 넘으므로(메소 증식), 마리당 비용으로 나눠 기록한다.
		if Unit.Unit_Info.RoleKey == "MeleeSwarm" then
			local swarmCount = math.floor(Unit.Unit_Info.AbilityValue)
			if swarmCount > 1 then
				Unit.Unit_Info.Meso = math.floor((Unit.Unit_Info.Meso or 0) / swarmCount)
				Unit.Unit_Info.Erda = math.floor((Unit.Unit_Info.Erda or 0) / swarmCount)
			end
		end
		
		-- 공격 스타일/이펙트: RoleKey(영문, 있으면 우선) 또는 CSV '역할' 문자열 + 데이터 힌트를 CombatConfig 로 해석해 주입.
		local role = Unitdata["역할"]
		if role ~= nil or Unit.Unit_Info.RoleKey ~= "" then
			local tRange = tonumber(Unitdata["Target"]) or 0
			-- AttackRange는 이제 위에서 /100 변환된 world-unit 값이다(근접 0.4~0.55, 원거리 1.5~3.8 정도).
			local rangedHint = Unit.Unit_Info.AttackRange >= 1.0 or tRange >= 2
			local cfg = _CombatConfig:Resolve(Unit.Unit_Info.RoleKey, role, rangedHint)
			Unit.Unit_Info.AttackStyle = cfg.attackType
			Unit.Unit_Info.AoeRadius = cfg.aoeRadius
			Unit.Unit_Info.ProjectileSpeed = cfg.projectileSpeed
			-- HitEffectRUID/ProjectileRUID: 유닛 .model에 직접 채워 넣은 고유 이펙트가 있으면 그걸 우선
			-- 쓰고, 비어 있을 때만(아직 손대지 않은 유닛) CombatConfig의 역할군 공용 기본값으로 채운다.
			-- ⚠ 예전엔 무조건 CombatConfig 값으로 덮어써서, .model의 Unit_Info에 직접 넣은 고유 RUID가
			-- 스폰될 때마다 매번 같은 공용 RUID로 사라지는 버그가 있었다(사용자가 모험가 유닛 다수에
			-- 개별 HitEffectRUID/ProjectileRUID를 채워 넣었는데 실제로는 하나도 반영되지 않던 원인).
			if Unit.Unit_Info.HitEffectRUID == "" then
				Unit.Unit_Info.HitEffectRUID = cfg.hitEffectRUID
			end
			if Unit.Unit_Info.ProjectileRUID == "" then
				Unit.Unit_Info.ProjectileRUID = cfg.projectileRUID
			end
			log("[SpawnUnit] " .. tostring(role) .. " (" .. tostring(Unit.Unit_Info.RoleKey) .. ") -> " .. cfg.attackType)
		end
	end

end